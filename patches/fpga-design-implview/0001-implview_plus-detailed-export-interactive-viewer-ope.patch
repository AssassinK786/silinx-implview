+const A = {};
+for (const [k, [t, off, n]] of Object.entries(M.arrays)) A[k] = new KIND[t](buf, off, n);
+$("loading").remove();
+
+const N = M.nsites, Q = M.q;
+const R = new Float32Array(4 * N);
