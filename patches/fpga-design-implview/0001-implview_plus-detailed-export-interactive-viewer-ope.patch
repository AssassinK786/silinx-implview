+}
+let heatCol = [];
+
+// ---- drawing
+function rectPath(r, k, x0, y0, x1, y1) {
+  const a = r[k], b = r[k + 1], c = r[k + 2], d = r[k + 3];
+  if (c < x0 || a > x1 || d < y0 || b > y1) return;
+  ctx.rect(a * view.s + view.tx, b * view.s + view.ty, (c - a) * view.s, (d - b) * view.s);
+}
+function sx(u) { return u * view.s + view.tx; }
