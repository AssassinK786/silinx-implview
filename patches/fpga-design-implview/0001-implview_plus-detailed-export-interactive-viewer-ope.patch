+    <h2>Utilization</h2>
+    <table id="util"></table>
+  </div>
+</div>
+<script type="text/plain" id="meta-data"></script>
+<script type="text/plain" id="bin-data"></script>
+<script>
+(async function () {
+const $ = id => document.getElementById(id);
+
+async function inflate(id) {
