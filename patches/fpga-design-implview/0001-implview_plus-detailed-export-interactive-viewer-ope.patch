+               ["allpaths", "All timing paths, as lines"], ["clocks", "Clock nets (routing)"]];
+  $("layers").innerHTML = lay.filter(([k]) => (k !== "pblocks" || M.pblocks.length) && (k !== "allpaths" || P.length) && (k !== "clocks" || D)).map(([k, l]) =>
