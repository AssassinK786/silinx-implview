+}
+
+const frameLines = t => String(t).split(/\r?\n/).map(l => l.trim()).filter(Boolean).sort();
+
+/** The open flow's build against its bitstream. */
+async function crossCheckOpenXc7(job, { buildDir, top, part, cfg }) {
+  const st = openXc7Status(cfg, part);
+  if (!st.tools.bit2fasm) throw new Error(`bit2fasm not found (paths.bit2fasm or PATH). ${st.help}`);
+  if (!st.db) throw new Error(`no Project X-Ray database of ${part} (openxc7.prjxrayDb)`);
+  const out = path.join(buildDir, 'openxc7');
+  const run = async (name, args) => { const code = await runCommand(job, st.tools[name], args, { cwd: out }); if (code !== 0) throw new Error(`${name} failed (exit code ${code})`); };
