+
+/** The database's features of the tile types of some features: key -> sets bits (core/crosscheck-fasm.js segbitsIndex). */
+async function dbIndex(dbRoot, features) {
+  const idx = new Map();
+  for (const t of new Set([...features].map(tileTypeOf))) {
+    const read = async k => fs.readFile(path.join(dbRoot, `${k}_${t.toLowerCase()}.db`), 'utf8').catch(() => '');
+    for (const [k, v] of segbitsIndex(await read('segbits'), await read('ppips'))) idx.set(k, v);
