+/** Vivado's build: implview crosscheck (its JSON report), with the open flow's build when there is one. */
+async function crossCheckVivado(job, { buildDir, top, part, cfg, withOpen }) {
+  const args = ['crosscheck', 'post_route.dcp', '-O', path.join('implview', 'crosscheck')];
