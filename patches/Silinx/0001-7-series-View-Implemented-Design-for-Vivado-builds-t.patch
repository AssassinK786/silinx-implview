@@ -0,0 +1,106 @@
+// The implview tool (fpga-design-implview, MIT, run as a program of its own: never part of Silinx) for a 7-series build
+// that Silinx's own flow did not make (#implview): View Implemented Design (FPGA) of AMD Vivado's routed checkpoint
+// (implview export --detail) and of the open 7-series flow's result (implview import-nextpnr, server/openxc7.js), and
+// Cross-Check (implview crosscheck, server/crosscheck.js).
+//
+// The program: Toolchain Settings' paths.implview (config.json only, as every program's path), else the umbrella
+// checkout's (<silinx>/../.venv/bin/implview), else implview on PATH. Its cache (the part's device file, the design
+// files) is the build folder's, build/implview/cache (IMPLVIEW_CACHE): nothing is written outside the project. Vivado
+// is the local one of Toolchain Settings (vivado.settings: its bin/vivado), as IMPLVIEW_VIVADO.
+import fs from 'node:fs/promises';
+import fss from 'node:fs';
+import path from 'node:path';
+import zlib from 'node:zlib';
+import { fileURLToPath } from 'node:url';
+import { loadConfig, resolveTool } from './toolchain.js';
+import { runCommand } from './jobs.js';
+import { parseIvd, parseIvdev, implviewModel, nextpnrModel } from '../core/implview-model.js';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+/** The model's format: a new one rebuilds build/implview/fpga-view.json. */
+const IMPLVIEW_MODEL_VERSION = 1;
+
+const IMPLVIEW_HELP = 'Install fpga-design-implview (pip install fpga-design-implview, or the umbrella checkout\'s setup: <silinx>/../.venv/bin/implview) or set "paths": {"implview": "/path/to/implview"} in ~/.silinx/config.json.';
+
+/** The implview program: { path, found, reason }. */
+export function implviewTool(cfg, { root = ROOT } = {}) {
+  if (cfg?.paths?.implview) {
+    const p = resolveTool('implview', cfg);
+    return p ? { found: true, path: p, reason: `paths.implview (${p})` } : { found: false, path: null, reason: `paths.implview (${cfg.paths.implview}) is not an executable file` };
+  }
+  const sibling = path.resolve(root, '..', '.venv', 'bin', 'implview');
+  if (fss.existsSync(sibling)) return { found: true, path: sibling, reason: `the umbrella checkout's (${sibling})` };
+  const onPath = resolveTool('implview', { paths: {} });
+  return onPath ? { found: true, path: onPath, reason: 'implview on PATH' } : { found: false, path: null, reason: 'implview not found (paths.implview, <silinx>/../.venv/bin/implview, PATH)' };
+}
+
+/** Vivado's program for implview: the local Vivado of Toolchain Settings (its settings64.sh's bin/vivado), else none
+ *  (implview then looks for one itself). */
+function vivadoForImplview(cfg) {
+  const s = cfg?.vivado?.settings;
+  if ((cfg?.vivado?.mode || 'docker') !== 'local' || !s) return null;
+  const v = path.join(path.dirname(s), 'bin', 'vivado');
+  return fss.existsSync(v) ? v : null;
+}
+
+/** The environment implview runs in: its cache in the build folder, the local Vivado. */
+function implviewEnv(cfg, buildDir) {
+  const vivado = vivadoForImplview(cfg);
+  return { IMPLVIEW_CACHE: path.join(buildDir, 'implview', 'cache'), ...(vivado ? { IMPLVIEW_VIVADO: vivado } : {}) };
+}
+
+/** Run implview in a job (its lines the job's): resolves, or throws with the program's exit code. */
+export async function runImplview(job, args, { buildDir, cfg = null, env = {} } = {}) {
+  cfg ||= await loadConfig();
+  const tool = implviewTool(cfg);
+  if (!tool.found) throw Object.assign(new Error(`${tool.reason}. ${IMPLVIEW_HELP}`), { status: 400 });
+  await fs.mkdir(path.join(buildDir, 'implview', 'cache'), { recursive: true });
+  const code = await runCommand(job, tool.path, args, { cwd: buildDir, env: { ...implviewEnv(cfg, buildDir), ...env } });
+  if (code !== 0) throw new Error(`implview ${args[0]} failed (exit code ${code})`);
+}
+
+const gunzipText = async f => zlib.gunzipSync(await fs.readFile(f)).toString('utf8');
+
+/** The device file of a part in the build's implview cache (implview's own name: <part>.ivdev.gz), else null. */
+export function deviceFileOf(buildDir, part) {
+  const dir = path.join(buildDir, 'implview', 'cache', 'devices');
+  try {
+    const f = fss.readdirSync(dir).find(n => n.toLowerCase() === `${String(part).toLowerCase()}.ivdev.gz`);
+    return f ? path.join(dir, f) : null;
+  } catch { return null; }
+}
+
+/** View Implemented Design of a Vivado build: implview export --detail of build/post_route.dcp into
+ *  build/implview/<top>.ivd.gz. */
+export async function exportVivadoView(job, { buildDir, top, cfg = null }) {
+  const dcp = path.join(buildDir, 'post_route.dcp');
+  if (!fss.existsSync(dcp)) throw Object.assign(new Error('no routed checkpoint (build/post_route.dcp): run Place & Route first'), { status: 400 });
+  job.log(`View Implemented Design (FPGA): implview export --detail of ${path.basename(dcp)}`);
+  await runImplview(job, ['export', '--detail', '--paths', '0', '-o', path.join('implview', `${top}.ivd.gz`), 'post_route.dcp'], { buildDir, cfg });
+}
+
+/** The model of the view (web/js/fpgaview.js's) of a 7-series build: Vivado's (build/implview/<top>.ivd.gz) or the open
+ *  flow's (build/openxc7/implview.ivd.gz with nextpnr's JSON), cached in build/implview/fpga-view.json by the files'
+ *  times. { available: false, reason } when the export is missing or older than the build. */
+export async function implviewViewModel(buildDir, top, { source }) {
+  const mtime = p => { try { return fss.statSync(p).mtimeMs; } catch { return 0; } };
+  const ivd = source === 'openxc7' ? path.join(buildDir, 'openxc7', 'implview.ivd.gz') : path.join(buildDir, 'implview', `${top}.ivd.gz`);
+  const built = source === 'openxc7' ? mtime(path.join(buildDir, 'openxc7', 'routed.json')) : mtime(path.join(buildDir, 'post_route.dcp'));
+  if (!built) return { available: false, reason: 'no-ncd' };
+  if (!mtime(ivd)) return { available: false, reason: 'no-xdl' };
+  if (mtime(ivd) < built) return { available: false, reason: 'stale' };
+  const design = parseIvd(await gunzipText(ivd));
+  const devFile = deviceFileOf(buildDir, design.info.part);
+  if (!devFile) return { available: false, reason: 'error', error: `no device file of ${design.info.part} in build/implview/cache: implview device ${design.info.part} (it needs Vivado once per part)` };
+  const key = `${IMPLVIEW_MODEL_VERSION}:${source}:${mtime(ivd)}:${mtime(devFile)}`;
+  const cache = path.join(buildDir, 'implview', `fpga-view-${source}.json`);
+  try { const c = JSON.parse(await fs.readFile(cache, 'utf8')); if (c.key === key) return c.model; } catch { /* not cached */ }
+  const dev = parseIvdev(await gunzipText(devFile));
+  const m = source === 'openxc7'
+    ? nextpnrModel(design, dev, JSON.parse(await fs.readFile(path.join(buildDir, 'openxc7', 'routed.json'), 'utf8')))
+    : implviewModel(design, dev);
+  const model = { available: true, ...m };
+  await fs.mkdir(path.dirname(cache), { recursive: true });
+  await fs.writeFile(cache, JSON.stringify({ key, model }));
+  return model;
+}
