diff --git a/web/js/crosscheck.js b/web/js/crosscheck.js
new file mode 100644
index 0000000..5c598d5
--- /dev/null
+++ b/web/js/crosscheck.js
@@ -0,0 +1,27 @@
+// Silinx - Cross-Check (#crosscheck): a 7-series build of AMD Vivado or of the open 7-series flow checked against its
+// bitstream on the server (server/crosscheck.js), its lines and its report in the console; the report is also
+// build/crosscheck.txt.
+import { api, followJob } from './api.js';
+import { S } from './app.js';
+import { log } from './console.js';
+import { CROSS_CHECK } from './tool-descriptors.js';
+import { renderProcesses } from './processes.js';
+
+export async function runCrossCheck() {
+  if (!S.project) return;
+  log(`\nStarted : "${CROSS_CHECK}".\n`, 'hdr');
+  S.status.crosscheck = 'running';
+  renderProcesses();
+  let res;
+  try {
+    const { job } = await api.crossCheck(S.project.name);
+    res = await followJob(job, line => log(line, /^ERROR/.test(line) ? 'err' : /^(CRITICAL )?WARNING|MISMATCH|DIFFERS/.test(line) ? 'warn' : undefined));
+  } catch (e) { res = { status: 'error', error: e.message }; }
+  const ok = res.status === 'ok';
+  const consistent = ok && (!res.result?.openxc7 || (res.result.openxc7.fasm.consistent && res.result.openxc7.frames.identical));
+  S.status.crosscheck = !ok ? 'err' : consistent && res.result?.checkable !== false ? 'ok' : 'warn';
+  renderProcesses();
+  if (ok) log(`\nProcess "${CROSS_CHECK}" completed successfully: the report is build/crosscheck.txt`, 'ok');
+  else log(`ERROR: ${CROSS_CHECK}: ${res.error || 'failed'}`, 'err');
+  return ok;
+}
