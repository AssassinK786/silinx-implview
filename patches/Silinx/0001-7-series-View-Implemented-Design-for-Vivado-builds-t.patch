+// The MCP server's tools of a 7-series build's implemented design (#implview, #crosscheck; server/mcp.js, #2674), as
+// the interface's View Implemented Design (FPGA) and Cross-Check: fpga_view, the model of the view (its utilisation and
+// modules, a site's cells and pins, a net's ends and route), made from AMD Vivado's or the open flow's build by
+// implview (server/implview.js); cross_check, the build against its bitstream (server/crosscheck.js).
+import path from 'node:path';
+import * as P from './projects.js';
+import { toolError, readProject, clip, PROJECT } from './mcp-util.js';
+
+const STR = d => ({ type: 'string', description: d });
+const wait = async (job, timeoutS, name) => {
+  const end = Date.now() + timeoutS * 1000;
+  while (job.status === 'running' && Date.now() < end) await new Promise(r => setTimeout(r, 250));
+  if (job.status === 'running') { (await import('./jobs.js')).cancelJob(job.id); throw toolError(`${name} did not end in ${timeoutS} s: stopped`); }
+  if (job.status !== 'ok') throw toolError(`${name} failed: ${job.error || 'see its log'}\n${job.lines.slice(-20).join('\n')}`);
+  return job;
+};
