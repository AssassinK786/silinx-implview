diff --git a/test/crosscheck-fasm.test.js b/test/crosscheck-fasm.test.js
new file mode 100644
index 0000000..4436ba9
--- /dev/null
+++ b/test/crosscheck-fasm.test.js
@@ -0,0 +1,88 @@
+// Cross-Check of an open 7-series build (#crosscheck, core/crosscheck-fasm.js): FASM as set bits, the database's features
+// of no bits, nextpnr's FASM against the decoded one (identical, consistent, a mismatch), the two builds side by side,
+// and the report's text (server/crosscheck.js).
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { fasmFeatures, segbitsIndex, featureKey, tileTypeOf, compareFasm, compareBuilds } from '../core/crosscheck-fasm.js';
+import { crossCheckText } from '../server/crosscheck.js';
+
+test('fasmFeatures: plain features, single bits, multi-bit values in binary and hex, comments, cleared values', () => {
+  const f = fasmFeatures(`# a comment
+CLBLL_L_X2Y62.SLICEL_X0.ALUT.INIT[7:0] = 8'b10000010
+CLBLL_L_X2Y62.SLICEL_X0.BLUT.INIT[63:32] = 32'h00000003   # trailing
+INT_L_X2Y62.IMUX_L3.LOGIC_OUTS_L4
+CLBLL_L_X2Y62.SLICEL_X0.AFF.ZINI = 1
+CLBLL_L_X2Y62.SLICEL_X0.BFF.ZINI = 0
+CLBLL_L_X2Y62.SLICEL_X1.CLUT.INIT[5]
+not a feature line =`);
+  assert.deepEqual([...f].sort(), ['CLBLL_L_X2Y62.SLICEL_X0.AFF.ZINI', 'CLBLL_L_X2Y62.SLICEL_X0.ALUT.INIT[1]', 'CLBLL_L_X2Y62.SLICEL_X0.ALUT.INIT[7]',
+    'CLBLL_L_X2Y62.SLICEL_X0.BLUT.INIT[32]', 'CLBLL_L_X2Y62.SLICEL_X0.BLUT.INIT[33]', 'CLBLL_L_X2Y62.SLICEL_X1.CLUT.INIT[5]', 'INT_L_X2Y62.IMUX_L3.LOGIC_OUTS_L4']);
+  // (the two writers' groupings of the same bits: the same set)
+  assert.deepEqual(fasmFeatures("T_X1Y1.A.INIT[63:0] = 64'h8000000000000001"), fasmFeatures('T_X1Y1.A.INIT[0]\nT_X1Y1.A.INIT[63]'));
+});
+
+test('the database: features with bits, of cleared bits only, pseudo pips; keys', () => {
+  const idx = segbitsIndex('CLBLL_L.SLICEL_X0.PRECYINIT.C0 !00_12 !30_13 !30_14\nCLBLL_L.SLICEL_X0.PRECYINIT.C1 00_12 !30_13\nCLBLL_L.SLICEL_X0.ALUT.INIT[0] 33_00\n',
+    'CLBLL_L.CLBLL_LL_A2.CLBLL_IMUX2 always\nCLBLL_L.SLICEL_X0.ALUT.INIT[0] default\n');
+  assert.equal(idx.get('CLBLL_L.SLICEL_X0.PRECYINIT.C0'), false);
+  assert.equal(idx.get('CLBLL_L.SLICEL_X0.PRECYINIT.C1'), true);
+  assert.equal(idx.get('CLBLL_L.CLBLL_LL_A2.CLBLL_IMUX2'), false);
+  assert.equal(idx.get('CLBLL_L.SLICEL_X0.ALUT.INIT[0]'), true);   // (the segbits' entry kept)
+  assert.equal(featureKey('CLBLL_L_X2Y62.SLICEL_X0.PRECYINIT.C0'), 'CLBLL_L.SLICEL_X0.PRECYINIT.C0');
+  assert.equal(tileTypeOf('RIOB33_SING_X31Y0.IOB_Y0.PULLTYPE.PULLDOWN'), 'RIOB33_SING');
+});
+
+const IDX = segbitsIndex('CLBLL_L.SLICEL_X0.PRECYINIT.C0 !00_12\nCLBLL_L.SLICEL_X0.ALUT.INIT[1] 33_01\nINT_L.IMUX_L3.LOGIC_OUTS_L4 01_02\nRIOB33.IOB_Y0.PULLTYPE.PULLDOWN 38_88\n', 'CLBLL_L.CLBLL_LL_A2.CLBLL_IMUX2 always\n');
+const bitsOf = k => IDX.get(k);
+
+test('compareFasm: identical; consistent (differences of no bits, an unused pad\'s defaults); a mismatch', () => {
+  const same = compareFasm({ nextpnr: 'INT_L_X2Y62.IMUX_L3.LOGIC_OUTS_L4\n', decoded: 'INT_L_X2Y62.IMUX_L3.LOGIC_OUTS_L4\n', bitsOf });
+  assert.equal(same.identical, true);
+  assert.equal(same.consistent, true);
+  const n = 'CLBLL_L_X2Y62.SLICEL_X0.ALUT.INIT[1:0] = 2\'b10\nCLBLL_L_X2Y62.CLBLL_LL_A2.CLBLL_IMUX2\nINT_L_X2Y62.IMUX_L3.LOGIC_OUTS_L4\n';
+  const d = 'CLBLL_L_X2Y62.SLICEL_X0.ALUT.INIT[1]\nCLBLL_L_X2Y62.SLICEL_X0.PRECYINIT.C0\nINT_L_X2Y62.IMUX_L3.LOGIC_OUTS_L4\nRIOB33_X31Y1.IOB_Y0.PULLTYPE.PULLDOWN\n';
+  const r = compareFasm({ nextpnr: n, decoded: d, bitsOf });
+  assert.equal(r.identical, false);
+  assert.equal(r.consistent, true);
+  assert.deepEqual([r.nextpnr, r.decoded, r.common], [3, 4, 2]);
+  assert.deepEqual(r.onlyNextpnr, { total: 1, noBits: 1, unexplained: 0, samples: [], noBitsSamples: ['CLBLL_L_X2Y62.CLBLL_LL_A2.CLBLL_IMUX2'] });
+  assert.equal(r.onlyDecoded.noBits, 1);
+  assert.equal(r.onlyDecoded.unusedSites, 1);
+  assert.equal(r.onlyDecoded.unexplained, 0);
+  const bad = compareFasm({ nextpnr: n + 'INT_L_X2Y63.IMUX_L3.LOGIC_OUTS_L4\n', decoded: d, bitsOf });
+  assert.equal(bad.consistent, false);
+  assert.deepEqual(bad.onlyNextpnr.samples, ['INT_L_X2Y63.IMUX_L3.LOGIC_OUTS_L4']);
+});
+
+test('compareBuilds: the counts of two models side by side', () => {
+  const m = (luts, ffs) => ({ insts: [{ type: 'SLICEL', cells: [...Array(luts)].map(() => ({ kind: 'lut' })).concat([...Array(ffs)].map(() => ({ kind: 'ff' }))) }, { type: 'IOB33', io: {}, cells: [{ kind: 'inbuf' }] }],
+    nets: [{ kind: 'signal', pips: 5 }, { kind: 'power', pips: 1 }] });
+  const rows = Object.fromEntries(compareBuilds(m(2, 3), m(4, 3)).map(r => [r.name, [r.vivado, r.open]]));
+  assert.deepEqual(rows.LUTs, [2, 4]);
+  assert.deepEqual(rows['Flip-flops'], [3, 3]);
+  assert.deepEqual(rows.Slices, [1, 1]);
+  assert.deepEqual(rows['I/Os'], [1, 1]);
+  assert.deepEqual(rows.Nets, [1, 1]);
+  assert.deepEqual(rows['Routing switches (PIPs)'], [6, 6]);
+});
+
+test('the report: Vivado\'s checks, the open flow\'s, an UltraScale+ part not cross-checkable', () => {
