new file mode 100644
index 0000000..de94166
--- /dev/null
+++ b/server/crosscheck.js
@@ -0,0 +1,143 @@
+// Cross-Check (#crosscheck; the process and the MCP server's cross_check): a 7-series build checked against its own
+// bitstream, decoded by an independent tool (Project X-Ray's bit2fasm), and the two implementations compared.
+//   - AMD Vivado's build: implview crosscheck of build/post_route.dcp (server/implview.js) - the used slices, LUT and FF
+//     BELs, each LUT's physical INIT, the flip-flops' INIT / reset and the slices' CE / SR / FFSYNC / LATCH / CLKINV, the
+//     pips - and Vivado's own checks (report_route_status, each net's ROUTE against get_nodes);
+//   - the open flow's (openXC7, server/openxc7.js): its bitstream decoded by bit2fasm against nextpnr's FASM
+//     (core/crosscheck-fasm.js), and the decoded FASM encoded again (fasm2frames) against the build's frames;
+//   - both: the two builds side by side (compareBuilds).
+// UltraScale+ and Versal: no open bitstream database (core/openxc7.js crossCheckability): Vivado's own checks only.
+// Writes build/crosscheck.json and build/crosscheck.txt (the report the console and the Design Summary show).
+import fs from 'node:fs/promises';
+import fss from 'node:fs';
+import path from 'node:path';
+import { loadConfig } from './toolchain.js';
+import { runCommand, capture } from './jobs.js';
+import { vivadoPart } from './vivado.js';
+import { runImplview, implviewViewModel, exportVivadoView } from './implview.js';
+import { openXc7Status } from './openxc7.js';
+import { crossCheckability } from '../core/openxc7.js';
+import { fasmFeatures, segbitsIndex, tileTypeOf, compareFasm, compareBuilds } from '../core/crosscheck-fasm.js';
+
+const mtime = p => { try { return fss.statSync(p).mtimeMs; } catch { return 0; } };
+
+/** Which builds of a project's build folder can be cross-checked: { vivado, openxc7 }. */
+export function buildsOf(buildDir, top) {
+  return {
+    vivado: !!mtime(path.join(buildDir, 'post_route.dcp')),
+    openxc7: !!mtime(path.join(buildDir, 'openxc7', 'routed.fasm')) && !!mtime(path.join(buildDir, 'openxc7', `${top}.bit`)),
