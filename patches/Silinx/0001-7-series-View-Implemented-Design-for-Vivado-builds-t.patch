+In short:
+
+- **View Implemented Design (FPGA) for AMD Vivado's 7-series builds:** the chip with its sites coloured by module, each
+  site's LUT equations and flip-flops, the nets and their routes, the clock network and the Design hierarchy in step,
+  made from the routed checkpoint by the implview tool (fpga-design-implview, run as a program of its own).
+- **The open 7-series flow (openXC7):** a synthesis tool of every 7-series project, the Spartan-7's too: Yosys
+  synth_xilinx, nextpnr-xilinx, Project X-Ray's fasm2frames and xc7frames2bit; its reports, its FPGA view, Configure
+  Target Device with openFPGALoader.
+- **Cross-Check Implementation against Bitstream:** a 7-series build checked against its own bitstream decoded by
+  Project X-Ray's bit2fasm; Vivado's build against the open flow's when there are both.
+
+In detail:
+
+- **View Implemented Design of a Vivado build (#9000):** the step fpgaview of Vivado's flow runs implview export --detail
+  on build/post_route.dcp (server/implview.js); core/implview-model.js makes its design and device files the view's model
+  (the tiles on Vivado's grid, family-neutral; each LUT's equation from its INIT and pin map, minimised; the flip-flops'
+  INIT, set / reset and synchronous mode; the nets' ends on the sites' pins and the tiles of their routes). The program:
+  paths.implview of config.json, else the umbrella checkout's .venv/bin/implview, else PATH; its cache in build/implview.
+- **The open 7-series flow, openXC7 (#9000):** the synthesis tool openxc7 (set_design_properties, Design Properties) on a
+  7-series device runs server/openxc7.js in build/openxc7: Verilog read by Yosys (deferred), VHDL and drawings through the
+  Silinx front end as one flat module; the XDC as nextpnr-xilinx reads it (core/openxc7.js); the chip database of
+  openxc7.chipdbs / openxc7.chipdbDir and Project X-Ray's database of openxc7.prjxrayDb (config.json only); the
+  bitstream copied to build/<top>.bit for Configure Target Device; its view implview import-nextpnr's placement with
+  nextpnr's INITs and routes.
+- **Cross-Check (#9000):** the process under Place & Route and the MCP server's cross_check (server/crosscheck.js,
+  core/crosscheck-fasm.js): implview crosscheck of a Vivado build; an open build's bitstream decoded and compared bit by
+  bit with nextpnr's FASM (the features of no configuration bit explained by the database) and encoded again against
+  its frames; both builds side by side; UltraScale+ and Versal not cross-checkable (Vivado's own checks only). The MCP
+  server's fpga_view gives the view's model (the utilisation and modules, a site, a net).
diff --git a/core/crosscheck-fasm.js b/core/crosscheck-fasm.js
new file mode 100644
index 0000000..62e3bd5
--- /dev/null
+++ b/core/crosscheck-fasm.js
@@ -0,0 +1,90 @@
+// Silinx - Cross-Check of an open 7-series build (#crosscheck, server/crosscheck.js): nextpnr-xilinx's FASM against the
+// FASM decoded back from the bitstream (Project X-Ray's bit2fasm), as sets of set bits. A multi-bit feature is its bits
+// (ALUT.INIT[63:0] = 64'b… -> ALUT.INIT[k] for each 1), so the two writers' ways of grouping them do not matter. What
+// only one side has is explained by the database: a feature of no configuration bit (a pseudo pip, ppips_*.db's
+// always / default / hint, or a segbits entry of cleared bits only, as PRECYINIT.C0) cannot be seen in a bitstream,
+// and bit2fasm decodes every unused slice's zero-bit defaults. Anything else is a mismatch.
+//
+//   fasmFeatures(text) -> Set     segbitsIndex(segbitsText, ppipsText) -> Map(key -> true (set bits) | false (none))
+//   compareFasm({ nextpnr, decoded, bitsOf }) -> { nextpnr, decoded, common, identical, onlyNextpnr, onlyDecoded, … }
+
+/** The set bits of a FASM text: 'TILE.FEATURE' or 'TILE.FEATURE[k]', its comments and cleared bits left out. */
+export function fasmFeatures(text) {
+  const out = new Set();
+  for (const raw of String(text || '').split(/\r?\n/)) {
+    const line = raw.replace(/#.*$/, '').trim();
+    if (!line) continue;
+    const m = /^([^\s=[]+)(?:\[(\d+)(?::(\d+))?\])?\s*(?:=\s*(\S+))?$/.exec(line);
+    if (!m) continue;
+    const [, name, hi, lo, value] = m;
+    if (value === undefined) { out.add(hi !== undefined && lo === undefined ? `${name}[${hi}]` : name); continue; }
+    const v = /^(\d+)'([bhd])([0-9a-fA-F_]+)$/.exec(value);
+    let bits;
+    try { bits = v ? BigInt(v[2] === 'b' ? `0b${v[3].replace(/_/g, '')}` : v[2] === 'h' ? `0x${v[3].replace(/_/g, '')}` : v[3]) : BigInt(value); }
+    catch { continue; }
+    if (hi === undefined) { if (bits) out.add(name); continue; }
+    const base = lo !== undefined ? +lo : +hi;
+    for (let k = 0; bits >> BigInt(k); k++) if ((bits >> BigInt(k)) & 1n) out.add(`${name}[${base + k}]`);
+  }
+  return out;
+}
+
+/** A tile's features in the database by their key (TILETYPE.FEATURE): true when it sets bits, false for a feature of
+ *  none (cleared bits only, or a pseudo pip). */
+export function segbitsIndex(segbitsText = '', ppipsText = '') {
+  const idx = new Map();
+  for (const line of String(segbitsText).split(/\r?\n/)) {
+    const w = line.trim().split(/\s+/);
+    if (!w[0]) continue;
+    idx.set(w[0], w.slice(1).some(b => /^\d+_\d+$/.test(b)));
+  }
+  for (const line of String(ppipsText).split(/\r?\n/)) {
+    const w = line.trim().split(/\s+/);
+    if (w[0] && !idx.has(w[0])) idx.set(w[0], false);
+  }
+  return idx;
+}
+
+/** A feature's database key: its tile's type (the tile's name without _X#Y#), then the feature. */
+export const featureKey = f => { const k = f.indexOf('.'); return k < 0 ? f : `${f.slice(0, k).replace(/_X\d+Y\d+$/, '')}${f.slice(k)}`; };
+export const tileTypeOf = f => f.slice(0, f.indexOf('.')).replace(/_X\d+Y\d+$/, '');
+
+/** nextpnr's FASM against the bitstream's: bitsOf(key) -> true | false | undefined (unknown). The build is consistent
+ *  when every difference is a feature of no bits (`identical`: no difference at all). Samples of each kind. */
+export function compareFasm({ nextpnr, decoded, bitsOf = () => undefined, samples = 10 }) {
+  const N = nextpnr instanceof Set ? nextpnr : fasmFeatures(nextpnr), D = decoded instanceof Set ? decoded : fasmFeatures(decoded);
+  const onlyN = [...N].filter(f => !D.has(f)).sort(), onlyD = [...D].filter(f => !N.has(f)).sort();
+  const noBits = f => bitsOf(featureKey(f.replace(/\[\d+\]$/, ''))) === false || bitsOf(featureKey(f)) === false;
+  const nZero = onlyN.filter(noBits), dZero = onlyD.filter(noBits);
+  // (bit2fasm decodes the defaults the bitstream writer sets on a site nextpnr does not use: an unused pad's IN_TERM,
+  // PULLTYPE, SLEW, STEPDOWN)
+  const site = f => f.split('.').slice(0, 2).join('.');
+  const usedSites = new Set([...N].map(site));
+  const nBad = onlyN.filter(f => !noBits(f)), dUnused = onlyD.filter(f => !noBits(f) && !usedSites.has(site(f))), dBad = onlyD.filter(f => !noBits(f) && usedSites.has(site(f)));
+  return {
+    nextpnr: N.size, decoded: D.size, common: N.size - onlyN.length,
+    identical: !onlyN.length && !onlyD.length,
+    consistent: !nBad.length && !dBad.length,
+    onlyNextpnr: { total: onlyN.length, noBits: nZero.length, unexplained: nBad.length, samples: nBad.slice(0, samples), noBitsSamples: nZero.slice(0, samples) },
+    onlyDecoded: { total: onlyD.length, noBits: dZero.length, unusedSites: dUnused.length, unusedSamples: dUnused.slice(0, samples), unexplained: dBad.length, samples: dBad.slice(0, samples), noBitsSamples: dZero.slice(0, samples) },
+  };
+}
+
+/** A structural comparison of two builds of the same design (Vivado's and the open flow's): their counts side by side
+ *  (from the models of the view: core/implview-model.js). */
+export function compareBuilds(vivado, open) {
+  const count = (m, f) => m.insts.reduce((a, i) => a + i.cells.filter(f).length, 0);
+  const rows = [
+    ['Slices', m => m.insts.filter(i => /^SLICE/.test(i.type)).length],
+    ['LUTs', m => count(m, c => c.kind === 'lut')],
+    ['Flip-flops', m => count(m, c => c.kind === 'ff' || c.kind === 'latch')],
+    ['Carry chains (CARRY4)', m => count(m, c => c.kind === 'carry')],
+    ['Block RAMs', m => count(m, c => c.kind === 'ramb')],
+    ['DSPs', m => count(m, c => c.kind === 'dsp')],
+    ['I/Os', m => m.insts.filter(i => i.io).length],
+    ['Global clock buffers', m => count(m, c => c.kind === 'bufg')],
+    ['Nets', m => m.nets.filter(n => n.kind !== 'power').length],
+    ['Routing switches (PIPs)', m => m.nets.reduce((a, n) => a + (n.pips || 0), 0)],
+  ];
+  return rows.map(([name, f]) => ({ name, vivado: f(vivado), open: f(open) }));
+}
diff --git a/core/implview-model.js b/core/implview-model.js
new file mode 100644
index 0000000..ffe5de2
--- /dev/null
+++ b/core/implview-model.js
@@ -0,0 +1,313 @@
+// Silinx - View Implemented Design (FPGA) of a 7-series build that Silinx's own flow did not make: AMD Vivado's routed
+// checkpoint, exported by the implview tool (implview export --detail: its design file, <top>.ivd.gz, and the part's
+// device file, <part>.ivdev.gz, both gzip'ed tab-separated records), or the open 7-series flow's (openXC7: Yosys
+// synth_xilinx, nextpnr-xilinx) placement, imported by implview import-nextpnr and completed from nextpnr's own JSON
+// (the cells' INIT and ports, the nets' ROUTING). Both become the model web/js/fpgaview.js draws
+// (packages/silinx-fpga/src/xdl.js fpgaModel's: the device's tiles, the used sites with their cells and pins, the nets).
+// Family-neutral: the tiles come from the device file on Vivado's tile grid (any series), the sites by their type.
+//
+//   parseIvd(text) -> { info, cells, details, nets, pads, pips }    parseIvdev(text) -> { info, tiles, sites, pins }
+//   implviewModel(parseIvd(..), parseIvdev(..)) -> model            nextpnrModel(parseIvd(..), parseIvdev(..), json) -> model
+//   lutEquation(init, pinmap) -> { eq, inputs }                     (eq in XDL's syntax over the BEL's pins A1..A6)
+import { quineMcCluskey } from './qm.js';
+
+/** A LUT equation with its inputs' net names, as the view writes the XDL's ('A1*~A2' -> 'a · ¬b'). */
+const prettyEquation = (eq, inputs) => String(eq).replace(/\bA(\d)\b/g, (m, n) => inputs[`A${n}`] || m)
+  .replace(/~/g, '¬').replace(/\*/g, ' · ').replace(/\+/g, ' + ');
+const UNESC = { n: '\n', t: '\t', '\\': '\\' };
+const unesc = s => String(s).replace(/\\(.)/g, (m, c) => UNESC[c] ?? m);
+const rows = text => String(text).split('\n').filter(Boolean).map(l => l.split('\t'));
+
+/** An implview design file's records (the text of <top>.ivd.gz). Throws on another file. */
+export function parseIvd(text) {
+  const r = rows(text);
+  if (r[0]?.[0] !== '#implview-design') throw new Error('not an implview design file');
+  const d = { info: {}, cells: [], details: new Map(), nets: [], pads: [], pips: new Map() };
+  for (const x of r.slice(1)) {
+    const k = x[0];
+    if (k === 'U') d.cells.push({ site: x[1], bel: x[2], ref: x[3], group: x[4], name: x[5] });
+    else if (k === 'C') d.details.set(+x[1], Object.fromEntries(x.slice(2).filter(v => v.includes('=')).map(v => { const u = unesc(v), i = u.indexOf('='); return [u.slice(0, i), u.slice(i + 1)]; })));
+    else if (k === 'W') d.nets[+x[1]] = { name: x[2], type: x[3], fanout: +x[4], routed: +x[5], pins: [], segs: [], pips: [] };
+    else if (k === 'Q' && d.nets[+x[1]]) d.nets[+x[1]].pins = x.slice(2);
+    else if (k === 'G' && d.nets[+x[1]]) d.nets[+x[1]].segs = x.slice(2).filter(s => s.includes(' ')).map(s => s.split(' '));
+    else if (k === 'I' && d.nets[+x[1]]) d.nets[+x[1]].pips = x.slice(2);
+    else if (k === 'O') d.pads.push({ site: x[1], port: x[2], cell: x[3] });
+    else if (k === 'P') d.pips.set(x[1], +x[2]);
+    else if (/^[a-z]/.test(k)) d.info[k] = x[1] ?? '';
+  }
+  d.nets = d.nets.filter(Boolean);
+  return d;
+}
+
+/** An implview device file's records (the text of <part>.ivdev.gz): its tiles on the grid and their sites. */
+export function parseIvdev(text) {
+  const r = rows(text);
+  if (r[0]?.[0] !== '#implview-device') throw new Error('not an implview device file');
+  const d = { info: {}, tiles: [], sites: [], pins: new Map() };
+  for (const x of r.slice(1)) {
+    const k = x[0];
+    if (k === 'T') d.tiles.push({ name: x[1], type: x[2], gx: +x[3], gy: +x[4] });
+    else if (k === 'S') d.sites.push({ tile: +x[1], name: x[2], type: x[3], bonded: x[5] === '1' });
+    else if (k === 'K') d.pins.set(x[2], x[1]);
+    else if (/^[a-z]/.test(k)) d.info[k] = x[1] ?? '';
+  }
+  return d;
+}
+
+/** A LUT's function on its BEL's pins: Vivado's INIT (logical inputs I0..) and pin map ('I0:A5 I1:A2') -> its equation
+ *  in XDL's syntax ('A2*~A5'), minimised (Quine-McCluskey), and the BEL pins it uses. A constant: '0' or '1'. */
+export function lutEquation(init, pinmap) {
+  const m = /^(\d+)'([hb])([0-9a-fA-F_]+)$/.exec(String(init || '').trim());
+  if (!m) return null;
+  const bits = BigInt(m[2] === 'h' ? `0x${m[3].replace(/_/g, '')}` : `0b${m[3].replace(/_/g, '')}`);
+  const map = Object.fromEntries(String(pinmap || '').split(/\s+/).filter(Boolean).map(p => p.split(':')));
+  const logical = Object.keys(map).map(k => +k.slice(1)).sort((a, b) => a - b);
+  const phys = [...new Set(logical.map(i => map[`I${i}`]))].sort();
+  if (!phys.length) return { eq: bits & 1n ? '1' : '0', inputs: [] };
+  let col = '';
+  for (let r = 0; r < 1 << phys.length; r++) {
+    // row r: input j of the column (the most significant first) is phys[j]
+    const v = Object.fromEntries(phys.map((p, j) => [p, (r >> (phys.length - 1 - j)) & 1]));
+    let a = 0;
+    for (const i of logical) if (v[map[`I${i}`]]) a |= 1 << i;
+    col += (bits >> BigInt(a)) & 1n ? '1' : '0';
+  }
+  if (!col.includes('1')) return { eq: '0', inputs: phys };
+  if (!col.includes('0')) return { eq: '1', inputs: phys };
+  const q = quineMcCluskey(col, phys.length);
+  const term = t => phys.map((p, j) => { const b = 1 << (phys.length - 1 - j); return t.mask & b ? null : t.value & b ? p : `~${p}`; }).filter(Boolean).join('*');
+  return { eq: q.terms.map(term).join('+'), inputs: phys };
+}
+
+// ------------------------------------------------------------------ sites and their kinds
+const isSliceType = t => /^SLICE/.test(t);
+export const isIoType = t => /^(IOB\d*[MS]?|IOB|IPAD|OPAD|IBUF|DIFF[MS]I?|IOBM|IOBS|HPIOB\w*|HRIO\w*|HDIOB\w*|XPIOB\w*)$/.test(t);
+const kindOf = type => (isSliceType(type) ? 'Slices' : isIoType(type) ? 'IOBs' : /^RAMB/.test(type) ? 'Block RAMs'
+  : /^(DSP\w*|MULT\w*)$/.test(type) ? 'Multipliers / DSPs' : /^(BUFG\w*|BUFGCTRL|BUFGCE\w*)$/.test(type) ? 'Global clock buffers'
+    : /^(MMCM\w*|PLL\w*|DCM\w*|XPLL|DPLL)$/.test(type) ? 'DCMs / PLLs' : null);
+const dirOf = name => { const k = String(name).lastIndexOf('/'); return k < 0 ? '' : name.slice(0, k); };
+const letter = bel => (/^([A-H])/.exec(bel) || [])[1] || '';
+
+/** The site pin of a cell's pin, by its BEL (7-series and UltraScale names): a LUT's inputs the BEL's pins A1..A6 under
+ *  its letter (B6LUT A3 -> B3), its output the letter (O6) or the letter's MUX (O5); a flip-flop's clock CLK, enable CE,
+ *  set / reset SR, output the letter's Q; anything else BEL.PIN. */
+function sitePin(bel, pin, physical) {
+  const L = letter(bel);
+  if (/^[A-H][56]LUT$/.test(bel)) {
+    if (/^(I\d|A\d)$/.test(pin)) return `${L}${(physical || pin).replace(/^A/, '')}`;
+    return /5LUT$/.test(bel) || pin === 'O5' ? `${L}MUX` : L;
+  }
+  if (/^[A-H]5?FF2?$/.test(bel)) {
+    if (/^(C|CK|CLK)$/.test(pin)) return 'CLK';
+    if (pin === 'CE') return 'CE';
+    if (/^(R|S|CLR|PRE|SR)$/.test(pin)) return 'SR';
+    if (pin === 'Q') return /5FF/.test(bel) ? `${L}MUX` : `${L}Q`;
+    if (pin === 'D') return `${L}X`;
+  }
+  return `${bel}.${pin}`;
+}
+
+/** The model of the view from cells placed on sites and nets between their pins (both front ends' common part).
+ *  cells: [{ name, site, bel, ref, init?, pinmap?, eq?, ffInit?, iostandard? }]; nets: [{ name, clock, pins: [[cell, pin]]
+ *  (the driver first), tiles, pips }]. */
+function buildModel({ dev, part, top, source, tool, cells, nets, pads = [] }) {
+  const tileOf = dev.tiles, siteInfo = new Map(dev.sites.map(s => [s.name, s]));
+  // the grid: every tile but the empty ones (NULL); its rows and columns Vivado's (gy, gx)
+  const bySiteTile = new Map();
+  for (const s of dev.sites) (bySiteTile.get(s.tile) || bySiteTile.set(s.tile, []).get(s.tile)).push([s.name, s.type, s.bonded ? 1 : 0]);
+  const tiles = [];
+  let rowsN = 0, colsN = 0;
+  tileOf.forEach((t, k) => {
+    rowsN = Math.max(rowsN, t.gy + 1); colsN = Math.max(colsN, t.gx + 1);
+    if (t.type !== 'NULL') tiles.push([t.gy, t.gx, t.name, t.type, bySiteTile.get(k) || []]);
+  });
+  // a site per used site, its cells
+  const insts = [], siteIdx = new Map(), cellSite = [];
+  const portOf = new Map(pads.map(p => [p.site, p.port]));
+  cells.forEach((c, ci) => {
+    let k = siteIdx.get(c.site);
+    if (k === undefined) {
+      const s = siteInfo.get(c.site);
+      k = insts.length; siteIdx.set(c.site, k);
+      insts.push({ name: portOf.get(c.site) || c.name, type: s?.type || c.site.replace(/_X\d+Y\d+$/, ''), site: c.site, tile: s ? tileOf[s.tile].name : '', placed: true, module: '', cells: [], opt: {}, pins: {} });
+    }
+    cellSite[ci] = k;
+    const inst = insts[k];
+    const cell = { bel: c.bel, kind: cellKind(c), name: c.name, ref: c.ref };
+    if (cell.kind === 'lut') {
+      const r = c.eq != null ? { eq: c.eq } : lutEquation(c.init, c.pinmap);
+      if (r) { cell.eq = r.eq; cell.size = 6; } else cell.text = c.ref;
+      if (c.init) cell.init = c.init;
+    }
+    if (cell.kind === 'ff' || cell.kind === 'latch') {
+      if (c.ffInit != null) inst.opt[`${c.bel}_INIT_ATTR`] = c.ffInit ? 'INIT1' : 'INIT0';
+      inst.opt[`${c.bel}_SR_ATTR`] = /^(FDPE|FDSE|LDPE)$/.test(c.ref) ? 'SRHIGH' : 'SRLOW';
+      inst.opt.SYNC_ATTR = /^(FDRE|FDSE)$/.test(c.ref) ? 'SYNC' : 'ASYNC';
+    }
+    if (c.iostandard) inst.opt.IOSTANDARD = c.iostandard;
+    for (const [k2, v] of Object.entries(c.props || {})) inst.opt[k2] = v;
+    inst.cells.push(cell);
+  });
+  // the module of a site: the most common hierarchy path of its logic
+  for (const inst of insts) {
+    const count = new Map();
+    for (const c of inst.cells) if (/^(lut|ff|latch|carry|mux|ram|ramb|dsp)/.test(c.kind)) count.set(dirOf(c.name), (count.get(dirOf(c.name)) || 0) + 1);
+    if (count.size) inst.module = [...count.entries()].sort((a, b) => b[1] - a[1] || a[0].length - b[0].length)[0][0];
+  }
+  // the nets, between the sites' pins
+  const outNets = [];
+  for (const n of nets) {
+    const ends = [];
+    for (const [ci, pin] of n.pins) {
+      const c = cells[ci];
+      if (!c || cellSite[ci] === undefined) continue;
+      ends.push([cellSite[ci], sitePin(c.bel, pin, c.phys?.[pin])]);
+    }
+    if (!ends.length) continue;
+    const idx = outNets.length;
+    outNets.push({ name: n.name, kind: n.power ? 'power' : n.clock ? 'clock' : 'signal', driver: ends[0], loads: ends.slice(1), tiles: n.tiles, pips: n.pips });
+    for (const [k, p] of ends) insts[k].pins[p] = idx;
+  }
+  // the LUTs' inputs as net names, the I/Os
+  for (const inst of insts) {
+    for (const c of inst.cells) if (c.kind === 'lut' && c.eq != null) {
+      const ins = {};
+      const usedPins = new Set(String(c.eq).match(/A[1-6]/g) || []);
+      for (let a = 1; a <= 6; a++) { if (!usedPins.has(`A${a}`)) continue; const ni = inst.pins[`${letter(c.bel)}${a}`]; if (ni !== undefined) ins[`A${a}`] = outNets[ni].name; }
+      c.inputs = ins;
+      c.text = prettyEquation(c.eq, ins);
+    }
+    if (isIoType(inst.type)) {
+      const out = inst.cells.some(c => /OBUF|OUTBUF/.test(c.ref) || /OUTBUF/.test(c.bel)), inp = inst.cells.some(c => /IBUF|INBUF/.test(c.ref) || /INBUF/.test(c.bel));
+      inst.io = { pad: dev.pins.get(inst.site) || inst.site, dir: out && inp ? 'inout' : out ? 'out' : 'in', standard: inst.opt.IOSTANDARD || null, drive: inst.opt.DRIVE || null, slew: inst.opt.SLEW || null, pull: inst.opt.PULLTYPE || null };
+    }
+  }
+  const util = {};
+  for (const s of dev.sites) { const k = kindOf(s.type); if (k && (k !== 'IOBs' || s.bonded)) (util[k] ||= { used: 0, total: 0 }).total++; }
+  const modules = {};
+  for (const inst of insts) { const k = kindOf(inst.type); if (k && util[k]) util[k].used++; if (k) modules[inst.module] = (modules[inst.module] || 0) + 1; }
+  return {
+    source, tool,
+    design: { name: top, part },
+    device: { part: dev.info.part || part, family: dev.info.family || dev.info.architecture || '', rows: rowsN, cols: colsN, tiles },
+    insts, nets: outNets, util, modules,
+  };
+}
+
+function cellKind({ ref = '', bel = '', group = '' }) {
+  if (/^LUT\d|^LUT$/.test(ref) || group === 'LUT') return 'lut';
+  if (/^(SRL|RAM\d|RAM[SD]\d|CFGLUT)/.test(ref) || /^(SRL|LUTRAM|DMEM)$/.test(group)) return 'ram';
+  if (/^LD/.test(ref)) return 'latch';
+  if (/^FD/.test(ref) || group === 'FLOP_LATCH' || /FF2?$/.test(bel)) return 'ff';
+  if (/^CARRY/.test(ref)) return 'carry';
+  if (/^MUXF/.test(ref)) return 'mux';
+  if (/^RAMB/.test(ref)) return 'ramb';
+  if (/^DSP/.test(ref)) return 'dsp';
+  if (/^(IBUF|IBUFDS|IOBUF)/.test(ref) || /INBUF/.test(bel)) return 'inbuf';
+  if (/^(OBUF)/.test(ref) || /OUTBUF/.test(bel)) return 'outbuf';
+  if (/^BUFG/.test(ref)) return 'bufg';
+  if (/^(MMCM|PLL)/.test(ref)) return 'dcm';
+  return String(ref || bel).toLowerCase();
+}
+
+/** Vivado's routed design as implview exported it (--detail), on its part's device file. */
+export function implviewModel(ivd, ivdev) {
+  const cells = ivd.cells.map((c, i) => {
+    const d = ivd.details.get(i) || {};
+    const ff = /^(FD|LD)/.test(c.ref) && /^1'b([01])$/.exec(d.INIT || '');
+    const props = {};
+    for (const k of ['DRIVE', 'SLEW', 'PULLTYPE']) if (d[k]) props[k] = d[k];
+    const phys = d.PINMAP ? Object.fromEntries(d.PINMAP.split(/\s+/).map(p => p.split(':'))) : null;
+    return { ...c, init: d.INIT, pinmap: d.PINMAP, phys, ffInit: ff ? +ff[1] : null, iostandard: d.IOSTANDARD || null, props };
+  });
+  const tilesOf = n => [...new Set(n.segs.flat())];
+  const nets = ivd.nets.map(n => ({
+    name: n.name, clock: /CLOCK/.test(n.type), power: /^(POWER|GROUND)$/.test(n.type),
+    pins: n.pins.filter(p => !p.startsWith('@')).map(p => { const i = p.indexOf(':'); return [+p.slice(0, i), p.slice(i + 1)]; }),
+    tiles: tilesOf(n), pips: n.pips.length,
+  }));
+  return buildModel({ dev: ivdev, part: ivd.info.part || ivdev.info.part, top: ivd.info.top, source: 'vivado', tool: ivd.info.vivado ? `AMD Vivado ${ivd.info.vivado}` : 'AMD Vivado', cells, nets, pads: ivd.pads });
+}
+
+/** A Yosys / nextpnr name as a hierarchy path: 'u_uart.u_rx.state_q' -> 'u_uart/u_rx/state_q'; Yosys's own ($abc$…,
+ *  $auto$…) at the top. */
+export const nextpnrPath = name => (String(name).startsWith('$') ? String(name) : String(name).replace(/\\/g, '').split('.').join('/'));
+
+/** The open 7-series flow's design: implview import-nextpnr's placement, each cell's INIT and ports and each net's
+ *  route from nextpnr's JSON (--write). */
+export function nextpnrModel(ivd, ivdev, json) {
+  const mod = Object.values(json?.modules || {}).find(m => m.attributes?.top) || Object.values(json?.modules || {})[0] || { cells: {}, netnames: {} };
+  const bitNet = new Map();
+  const netList = [];
+  for (const [name, n] of Object.entries(mod.netnames || {})) {
+    if ((n.bits || []).length !== 1 || typeof n.bits[0] !== 'number' || bitNet.has(n.bits[0])) continue;
+    const routing = String(n.attributes?.ROUTING || '').split(';');
+    const tiles = new Set(); let pips = 0;
+    for (let k = 0; k + 2 < routing.length; k += 3) {
+      const w = /^([A-Z0-9_]+_X\d+Y\d+)\//.exec(routing[k]);
+      if (w && !/^SITEWIRE/.test(routing[k])) tiles.add(w[1]);
+      if (routing[k + 1] && !/^SITEPIP/.test(routing[k + 1])) pips++;
+    }
+    bitNet.set(n.bits[0], netList.length);
+    netList.push({ name: nextpnrPath(name), clock: false, power: /\$PACKER_(VCC|GND)/.test(name), pins: [], tiles: [...tiles], pips });
+  }
+  // (a bus's bits: their names, where a single-bit net of the bit has only Yosys's own)
+  for (const [name, n] of Object.entries(mod.netnames || {})) {
+    if ((n.bits || []).length < 2 || name.startsWith('$')) continue;
+    n.bits.forEach((b, i) => { const k = bitNet.get(b); if (k !== undefined && netList[k].name.startsWith('$')) netList[k].name = `${nextpnrPath(name)}[${i}]`; });
+  }
+  const cells = [];
+  const byName = new Map(ivd.cells.map(c => [c.name, c]));
+  for (const [cname, c] of Object.entries(mod.cells || {})) {
+    const u = byName.get(cname);
+    if (!u) continue;
+    const ref = c.attributes?.X_ORIG_TYPE || u.ref;
+    const ci = cells.length;
+    // (a Yosys cell's own name, $abc$…, says nothing: its hierarchy path from hdlname, else from its output's net)
+    const outNet = Object.entries(c.connections || {}).find(([p, b]) => (c.port_directions || {})[p] === 'output' && typeof b[0] === 'number' && bitNet.has(b[0]));
+    const named = c.attributes?.hdlname ? c.attributes.hdlname.split(' ').join('/') : !cname.startsWith('$') ? nextpnrPath(cname)
+      : outNet && !netList[bitNet.get(outNet[1][0])].name.startsWith('$') ? netList[bitNet.get(outNet[1][0])].name : cname;
+    const cell = { name: named, site: u.site, bel: u.bel, ref, group: u.group };
+    if (c.type === 'SLICE_LUTX') {
+      // nextpnr's INIT is on the BEL's pins already (A1..A6, the string's last character address 0)
+      const used = Object.entries(c.connections || {}).filter(([p, b]) => /^A\d$/.test(p) && b.length && typeof b[0] === 'number').map(([p]) => p);
+      const bits = String(c.parameters?.INIT || '0');
+      const pinmap = used.map(p => `I${+p[1] - 1}:${p}`).join(' ');
+      cell.init = `${bits.length}'b${bits}`; cell.pinmap = pinmap;
+      const full = `64'b${bits.padStart(64, '0')}`;
+      const all = Array.from({ length: 6 }, (_, k) => `I${k}:A${k + 1}`).join(' ');
+      const r = lutEquation(full, all);
+      // the function of the used pins only (an unconnected pin's value never reaches it)
+      cell.eq = r ? restrictEq(full, used) : null;
+    }
+    if (c.type === 'SLICE_FFX') { const v = String(c.parameters?.INIT ?? ''); cell.ffInit = /^[01]$/.test(v.slice(-1)) ? +v.slice(-1) : null; }
+    if (c.attributes?.IOSTANDARD) cell.iostandard = c.attributes.IOSTANDARD;
+    cells.push(cell);
+    const dirs = c.port_directions || {};
+    for (const [p, b] of Object.entries(c.connections || {})) {
+      if (!b.length || typeof b[0] !== 'number' || !bitNet.has(b[0])) continue;
+      const n = netList[bitNet.get(b[0])];
+      if (dirs[p] === 'output') n.pins.unshift([ci, p]); else n.pins.push([ci, p]);
+      if (/^(CK|CLK)$/.test(p) && c.type === 'SLICE_FFX') n.clockLoads = (n.clockLoads || 0) + 1;
+      if (/^BUFG/.test(c.type) && dirs[p] === 'output') n.clock = true;
+    }
+  }
+  for (const n of netList) if (n.clockLoads > 1 && !n.power) n.clock = true;
+  const part = ivd.info.part || ivdev.info.part;
+  return buildModel({ dev: ivdev, part, top: ivd.info.top, source: 'openxc7', tool: ivd.info.nextpnr || 'nextpnr-xilinx', cells, nets: netList });
+}
+
+/** A 64-bit LUT INIT (on A1..A6) restricted to its connected pins, the others 0: its equation. */
+function restrictEq(full, used) {
+  if (!used.length) return /1$/.test(full) ? '1' : '0';
+  const pinmap = used.map((p, k) => `I${k}:${p}`).join(' ');
+  // the logical table over the used pins: row a of the used pins -> the 64-bit address with the others 0
+  const b = BigInt(`0b${full.slice(4)}`);
+  let bits = 0n;
+  for (let a = 0; a < 1 << used.length; a++) {
+    let addr = 0;
+    used.forEach((p, k) => { if (a >> k & 1) addr |= 1 << (+p[1] - 1); });
+    if ((b >> BigInt(addr)) & 1n) bits |= 1n << BigInt(a);
+  }
+  return lutEquation(`${1 << used.length}'h${bits.toString(16)}`, pinmap)?.eq ?? null;
+}
diff --git a/core/openxc7.js b/core/openxc7.js
new file mode 100644
index 0000000..10f08fc
--- /dev/null
+++ b/core/openxc7.js
@@ -0,0 +1,117 @@
+// Silinx - the open 7-series flow of the native tools (openXC7: Yosys synth_xilinx, nextpnr-xilinx, Project X-Ray's
+// fasm2frames and xc7frames2bit; server/openxc7.js runs them, #openxc7): what needs no program, kept apart to be tested
+// alone. The project's XDC as nextpnr-xilinx reads it, its clock's frequency, the part's names in the tools' databases,
+// nextpnr's log as the Design Summary's reports, and which families can be cross-checked against an open bitstream
+// database (core/crosscheck-fasm.js compares the features).
+//
+//   nextpnrXdc(xdcText) -> { text, freqMHz, ports, dropped }      nextpnrReports(logText) -> { utilization, timing, routed }
+//   prjxrayFamily(part) -> 'spartan7' | …                          crossCheckability(device) -> { open, reason }
+
+/** The family folder of a part in Project X-Ray's database (prjxray-db/<family>/<part>). */
+export function prjxrayFamily(part) {
+  const p = String(part || '').toLowerCase();
+  return /^xc7a/.test(p) ? 'artix7' : /^xc7s/.test(p) ? 'spartan7' : /^xc7z/.test(p) ? 'zynq7' : /^xc7k/.test(p) ? 'kintex7' : null;
+}
+
+/** The database's names to try for a full part name (xc7a35ticsg324-1l: the industrial and low-power grades share the
+ *  commercial fabric, xc7a35tcsg324-1). */
+export function prjxrayParts(fullPart) {
+  const p = String(fullPart || '').toLowerCase();
+  const m = /^(xc7[askz]\d+t?)(i?)([a-z]+\d+)-(\w+)$/.exec(p);
+  if (!m) return [p];
+  return [...new Set([p, `${m[1]}${m[3]}-${m[4]}`, `${m[1]}${m[3]}-1`])];
+}
+
+/** Can a device's build be decoded from its bitstream by an open database? The 7-series: Project X-Ray. UltraScale+:
+ *  Project U-Ray's database is partial; Versal: none. { open, family, reason }. */
+export function crossCheckability(device) {
+  const part = String(device?.part || device || '').toLowerCase();
+  if (/^xc7[askz]/.test(part)) return { open: true, family: '7-series', reason: 'Project X-Ray database (bit2fasm)' };
+  if (/^(xcvc|xcvm|xcve|xcvp|xcvh|xqvc|xqvm)/.test(part)) return { open: false, family: 'Versal', reason: 'no open bitstream database (Versal): not cross-checkable; Vivado-internal checks only (report_route_status, ROUTE vs get_nodes)' };
+  if (/^(xc[kvz]u\d+p|xczu|xcau|xcku\d+p|xcvu\d+p|xqzu)/.test(part)) return { open: false, family: 'UltraScale+', reason: 'prjuray partial (UltraScale+): not cross-checkable; Vivado-internal checks only (report_route_status, ROUTE vs get_nodes)' };
+  if (/^(xcku|xcvu)\d/.test(part)) return { open: false, family: 'UltraScale', reason: 'no open bitstream database (UltraScale): not cross-checkable; Vivado-internal checks only (report_route_status, ROUTE vs get_nodes)' };
+  return { open: false, family: 'unknown', reason: `${part || 'the device'}: no open bitstream database known` };
+}
+
+// one Tcl command's words: braces and brackets kept whole
+function words(line) {
+  const out = [];
+  let i = 0;
+  while (i < line.length) {
+    if (/\s/.test(line[i])) { i++; continue; }
+    const open = line[i], close = { '{': '}', '[': ']', '"': '"' }[open];
+    if (close) {
+      let depth = 0, j = i;
+      for (; j < line.length; j++) {
+        if (line[j] === open && open !== '"') depth++;
+        else if (line[j] === close) { if (open === '"' && j > i) break; if (--depth === 0) break; }
+      }
+      out.push(line.slice(i, j + 1)); i = j + 1;
+    } else { const j = line.slice(i).search(/\s/); out.push(j < 0 ? line.slice(i) : line.slice(i, i + j)); i = j < 0 ? line.length : i + j; }
+  }
+  return out;
+}
+const portsOf = w => { const m = /^\[\s*get_ports\s+(.*?)\s*\]$/.exec(w || ''); return m ? words(m[1].replace(/^\{\s*|\s*\}$/g, '')).map(p => p.replace(/^[{"]|[}"]$/g, '')) : null; };
+
+/** The XDC as nextpnr-xilinx reads it (set_property NAME VALUE [get_ports port], one per line: no -dict, no braces around
+ *  a single port), the frequency of its first clock (create_clock -period, MHz) and what it leaves out. */
+export function nextpnrXdc(xdcText) {
+  const out = [], dropped = [], ports = new Set();
+  let freqMHz = null;
+  const text = String(xdcText || '').replace(/\\\r?\n/g, ' ');
+  for (const raw of text.split(/\r?\n/)) {
+    const line = raw.replace(/(^|;)\s*#.*$/, '').trim();
+    if (!line) continue;
+    const w = words(line);
+    if (w[0] === 'set_property' && w[1] === '-dict') {
+      const kv = words(w[2].replace(/^\{|\}$/g, '')), ps = portsOf(w[3]);
+      if (!ps) { dropped.push(raw.trim()); continue; }
+      for (let k = 0; k + 1 < kv.length; k += 2) for (const p of ps) { out.push(`set_property ${kv[k]} ${kv[k + 1]} [get_ports {${p}}]`); ports.add(p); }
+    } else if (w[0] === 'set_property' && w.length >= 4) {
+      const ps = portsOf(w[3]);
+      if (!ps) { dropped.push(raw.trim()); continue; }
+      for (const p of ps) { out.push(`set_property ${w[1]} ${w[2]} [get_ports {${p}}]`); ports.add(p); }
+    } else if (w[0] === 'create_clock') {
+      const k = w.indexOf('-period');
+      if (k >= 0 && freqMHz === null && +w[k + 1] > 0) freqMHz = +(1000 / +w[k + 1]).toFixed(3);
+    } else dropped.push(raw.trim());
+  }
+  return { text: out.join('\n') + (out.length ? '\n' : ''), freqMHz, ports: [...ports], dropped };
+}
+
+/** nextpnr-xilinx's log as reports: its utilisation ([{ name, used, total, percent }]), its timing ({ met, maxFreqMHz,
+ *  clocks: [{ clock, maxFreqMHz, targetMHz, pass }] }) and whether it routed every net. */
+export function nextpnrReports(logText) {
+  const utilization = [], clocks = [];
+  let inUtil = false;
+  for (const line of String(logText || '').split(/\r?\n/)) {
+    if (/Device utilisation:/.test(line)) { inUtil = true; utilization.length = 0; continue; }
+    if (inUtil) {
+      const m = /^Info:\s+(\S+):\s+(\d+)\/\s*(\d+)\s+(\d+)%/.exec(line);
+      if (m) { utilization.push({ name: m[1], used: +m[2], total: +m[3], percent: +m[4] }); continue; }
+      if (!/^Info:\s*$/.test(line)) inUtil = false;
+    }
+    const f = /Max frequency for clock\s+'([^']+)':\s+([\d.]+) MHz \((PASS|FAIL) at ([\d.]+) MHz\)/.exec(line);
+    if (f) {
+      const c = { clock: f[1], maxFreqMHz: +f[2], targetMHz: +f[4], pass: f[3] === 'PASS' };
+      const k = clocks.findIndex(x => x.clock === c.clock);
+      if (k >= 0) clocks[k] = c; else clocks.push(c);   // (the last estimate: after routing)
+    }
+  }
+  const log = String(logText || '');
+  const routed = /Routing complete\.|Router2 time|Program finished normally\./.test(log) && !/ERROR:/.test(log);
+  const worst = clocks.length ? clocks.reduce((a, b) => (b.maxFreqMHz < a.maxFreqMHz ? b : a)) : null;
+  return {
+    utilization: utilization.filter(u => u.used > 0 || /^(SLICE_LUTX|SLICE_FFX|IOB33|RAMB|DSP|BUFGCTRL)/.test(u.name)),
+    timing: { met: clocks.length ? clocks.every(c => c.pass) : null, timingErrors: clocks.filter(c => !c.pass).length, maxFreqMHz: worst?.maxFreqMHz ?? null, minPeriodNs: worst ? +(1000 / worst.maxFreqMHz).toFixed(3) : null, clocks, model: "nextpnr-xilinx's estimate" },
+    routed,
+  };
+}
+
+/** The Design Summary's headline counts of nextpnr's utilisation (as Vivado's: LUTs, FFs, IOBs, BRAM, DSP, BUFG). */
+export function nextpnrSummary(utilization) {
+  const pick = re => { const u = utilization.filter(x => re.test(x.name)); return u.length ? { used: u.reduce((a, x) => a + x.used, 0), total: u.reduce((a, x) => a + x.total, 0), percent: null } : null; };
+  const out = { luts: pick(/^SLICE_LUTX$/), ffs: pick(/^SLICE_FFX$/), iobs: pick(/^PAD$/), bram: pick(/^RAMB(18|36)E1$/), dsp: pick(/^DSP48E1$/), bufg: pick(/^BUFGCTRL$/), carry: pick(/^CARRY4$/) };
+  for (const v of Object.values(out)) if (v?.total) v.percent = +(100 * v.used / v.total).toFixed(2);
+  return out;
+}
