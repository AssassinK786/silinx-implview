+  job.log(`$ bit2fasm --db-root ${st.db.root} --part ${st.db.part} ${top}.bit > decoded.fasm`);
+  const dec = await capture(st.tools.bit2fasm, ['--db-root', st.db.root, '--part', st.db.part, `${top}.bit`], { cwd: out, timeoutMs: 600000 });
+  if (dec.code !== 0) throw new Error(`bit2fasm failed (exit code ${dec.code})`);
+  const lines = String(dec.out).split(/\r?\n/).filter(l => /^[A-Z0-9_]+_X\d+Y\d+\.\S/.test(l));   // (its warnings on the same stream left out)
+  await fs.writeFile(path.join(out, 'decoded.fasm'), lines.join('\n') + '\n');
