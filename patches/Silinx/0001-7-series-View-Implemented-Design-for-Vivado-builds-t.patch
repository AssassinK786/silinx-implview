index 0000000..964054a
--- /dev/null
+++ b/server/openxc7.js
@@ -0,0 +1,183 @@
+// The open 7-series flow of the native tools (openXC7, #openxc7): the project's synthesis tool 'openxc7' on a 7-series
+// device (the Spartan-7's too, which Silinx's own 7-series back end does not implement). Its steps, ISE's names:
+//   synth  -> Yosys synth_xilinx (its statistics)        translate, map -> the constraints (nextpnr reads the XDC)
+//   par    -> nextpnr-xilinx (the part's chip database)   trce -> nextpnr's timing estimate (its log)
+//   bitgen -> Project X-Ray's fasm2frames and xc7frames2bit
+//   fpgaview -> implview import-nextpnr (server/implview.js): the placement for View Implemented Design
+// Everything in build/openxc7/ (the bitstream build/openxc7/<top>.bit, copied to build/<top>.bit for Configure Target
+// Device): a Vivado build's files of build/ stay. The programs: Toolchain Settings' paths (config.json only: yosys,
+// nextpnr-xilinx, fasm2frames, xc7frames2bit, bit2fasm), else PATH; the data: openxc7.chipdbs ({ part: file }) or
+// openxc7.chipdbDir (<part>.chipdb or <part>.bin), openxc7.prjxrayDb (Project X-Ray's database root).
+import fs from 'node:fs/promises';
+import fss from 'node:fs';
+import path from 'node:path';
+import { generateBuild } from './ise.js';
+import { loadConfig, resolveTool } from './toolchain.js';
+import { runCommand } from './jobs.js';
+import { vivadoPart } from './vivado.js';
+import { hiddenIn, within } from './paths.js';
+import { nextpnrXdc, nextpnrReports, nextpnrSummary, prjxrayFamily, prjxrayParts } from '../core/openxc7.js';
+import { runImplview, deviceFileOf } from './implview.js';
+
+const OPENXC7_STEPS = ['synth', 'translate', 'map', 'par', 'trce', 'bitgen', 'fpgaview'];
+const DEFAULT_STEPS = ['synth', 'translate', 'map', 'par', 'trce', 'bitgen'];
+const OPENXC7_TOOLS = ['yosys', 'nextpnr-xilinx', 'fasm2frames', 'xc7frames2bit', 'bit2fasm'];
+const OPENXC7_HELP = 'Install the openXC7 tools (yosys, nextpnr-xilinx, fasm2frames, xc7frames2bit, bit2fasm) on PATH or name them in ~/.silinx/config.json ("paths": {"nextpnr-xilinx": "…"}), and set "openxc7": {"chipdbs": {"<part>": "<file>.chipdb"}, "prjxrayDb": "<prjxray-db>"} (or "chipdbDir").';
+
+/** The steps of a request in the flow's order; another flow's step: an error. */
+export function openXc7Steps(steps) {
+  const list = !steps || !steps.length ? DEFAULT_STEPS : steps;
+  for (const s of list) if (!OPENXC7_STEPS.includes(s)) throw Object.assign(new Error(`the open 7-series flow (openXC7) has no step '${s}' (${OPENXC7_STEPS.join(', ')})`), { status: 400 });
+  const set = new Set(list);
+  if (set.has('par')) set.add('trce');
+  return OPENXC7_STEPS.filter(s => set.has(s));
+}
+
+/** The chip database of a part: openxc7.chipdbs[part], else <chipdbDir>/<part>.chipdb | .bin; null if none. */
+export function chipdbOf(cfg, part) {
+  const o = cfg?.openxc7 || {};
+  const named = o.chipdbs?.[part];
+  if (named) return fss.existsSync(named) ? named : null;
+  for (const ext of ['.chipdb', '.bin']) { const f = o.chipdbDir && path.join(o.chipdbDir, `${part}${ext}`); if (f && fss.existsSync(f)) return f; }
+  return null;
+}
+
+/** Project X-Ray's database of a part: { root (the family's folder), part (its name there) } or null. */
+export function prjxrayDbOf(cfg, part) {
+  const root = cfg?.openxc7?.prjxrayDb, fam = prjxrayFamily(part);
+  if (!root || !fam) return null;
+  for (const p of prjxrayParts(part)) if (fss.existsSync(path.join(root, fam, p, 'part.yaml'))) return { root: path.join(root, fam), part: p };
+  return null;
+}
+
+/** Can the flow run for a part? { available, reason, tools: { name: path | null }, chipdb, db }. */
+export function openXc7Status(cfg, part) {
+  const tools = Object.fromEntries(OPENXC7_TOOLS.map(t => [t, resolveTool(t, cfg)]));
+  const chipdb = part ? chipdbOf(cfg, part) : null, db = part ? prjxrayDbOf(cfg, part) : null;
+  const missing = OPENXC7_TOOLS.filter(t => t !== 'bit2fasm' && !tools[t]);
+  const reason = missing.length ? `${missing.join(', ')} not found` : part && !chipdb ? `no nextpnr-xilinx chip database of ${part}` : part && !db ? `no Project X-Ray database of ${part}` : 'openXC7 tools found';
+  return { available: !missing.length && (!part || (!!chipdb && !!db)), reason, help: OPENXC7_HELP, tools, chipdb, db };
+}
+
+/** The Yosys script of the synthesis: the sources read (Verilog natively; VHDL and drawings as the Silinx front end's
+ *  flat Verilog, `flat`), synth_xilinx, the statistics, the netlist. */
+export function yosysScript({ top, sources, flat = null }) {
+  // (-defer: each module elaborated with the parameters its instance gives it, a generate branch left out not read)
+  const reads = flat ? [`read_verilog -sv ${flat}`] : sources.map(s => `read_verilog -defer -sv ${s}`);
+  return [...reads, `synth_xilinx -flatten -nodsp -arch xc7 -top ${top}`, 'delete t:$scopeinfo', 'tee -o synth_stat.txt stat', 'write_json synth.json', ''].join('\n');
+}
+
+/** Job body of the open 7-series flow: { project, projectDir, steps }. */
+export async function runOpenXc7(job, { project, projectDir, steps }) {
+  const st = openXc7Steps(steps);
+  const part = vivadoPart(project.device);
+  job.log(`Silinx implementation (open 7-series flow, openXC7): ${project.name} top=${project.top} part=${part}`);
+  const cfg = await loadConfig();
+  const status = openXc7Status(cfg, part);
+  const gen = await generateBuild(project, projectDir, { sourcesOnly: true });
+  const out = path.join(gen.buildDir, 'openxc7');
+  await fs.mkdir(out, { recursive: true });
+  const result = { buildDir: gen.buildDir, steps: st, completedSteps: [], failedStep: null, toolchain: 'openxc7', warnings: [...gen.warnings] };
+  for (const w of gen.warnings) job.log(`WARNING: ${w}`);
+  const needs = st.filter(s => s !== 'fpgaview' && s !== 'translate' && s !== 'map' && s !== 'trce');
+  if (needs.length && !status.available) {
+    job.log(`How to fix: ${OPENXC7_HELP}`);
+    throw Object.assign(new Error(`the open 7-series flow (openXC7) is not available for ${part}: ${status.reason}`), { result });
+  }
+  const top = gen.top;
+  const run = async (step, fn) => {
+    if (!st.includes(step)) return;
+    job.log(`=== SILINX STEP ${step} ===`);
+    try { await fn(); } catch (e) { result.failedStep = step; job.log(`=== SILINX FAILED ${step} ===`); throw Object.assign(e, { result }); }
+    result.completedSteps.push(step);
+    job.result = result;
+  };
+  const tool = async (name, args, opts = {}) => {
+    const code = await runCommand(job, status.tools[name], args, { cwd: out, ...opts });
+    if (code !== 0) throw new Error(`${name} failed (exit code ${code})`);
+  };
+  await run('synth', async () => {
+    for (const f of ['synth.json', 'routed.json', 'routed.fasm', 'nextpnr.log', 'frames', `${top}.bit`, 'implview.ivd.gz']) await fs.rm(path.join(out, f), { force: true });
+    const verilogOnly = gen.sources.every(s => s.lang === 'verilog');
+    let flat = null;
+    if (!verilogOnly) {
+      // (VHDL, drawings: the Silinx front end's elaborated design as one flat Verilog module; its hierarchy flattened)
+      const { flowFrontEnd } = await import('../core/synth-front.js');
+      const srcs = await Promise.all(gen.sources.map(async s => ({ path: s.path, lang: s.lang, text: await fs.readFile(path.join(gen.buildDir, s.buildPath), 'utf8') })));
+      const fe = flowFrontEnd(srcs, top);
+      if (fe.errors.length) throw new Error(`the design has errors:\n${fe.errors.join('\n')}`);
+      const input = fe.input();
+      for (const w of input.warnings || []) job.log(`WARNING:Silinx - ${w}`);
+      await fs.writeFile(path.join(out, `${top}_flat.sv`), input.text);
+      flat = `${top}_flat.sv`;
+      job.log('The VHDL sources (and drawings) read through the Silinx front end, as one flat Verilog module: the hierarchy is flattened.');
+    }
+    await fs.writeFile(path.join(out, 'synth.ys'), yosysScript({ top, sources: gen.sources.map(s => path.relative(out, path.join(gen.buildDir, s.buildPath))), flat }));
+    await tool('yosys', ['-q', '-l', 'yosys.log', '-s', 'synth.ys']);
+  });
+  if (st.includes('translate') || st.includes('par')) {
+    // the constraints: the project's XDC as nextpnr-xilinx reads it
+    const cons = project.constraints && path.resolve(projectDir, project.constraints);
+    if (cons && (!within(projectDir, cons) || hiddenIn(projectDir, cons))) throw Object.assign(new Error(`the constraints file ${project.constraints} is not one of the project's files`), { status: 400, result });
+    const xdc = cons && /\.xdc$/i.test(cons) && fss.existsSync(cons) ? await fs.readFile(cons, 'utf8') : '';
+    if (!xdc) result.warnings.push('no XDC constraints file: nextpnr-xilinx chooses the pins - do NOT program real hardware with this bitstream');
+    const x = nextpnrXdc(xdc);
+    for (const d of x.dropped) job.log(`INFO: nextpnr-xilinx does not read this constraint (left out): ${d}`);
+    await fs.writeFile(path.join(out, 'nextpnr.xdc'), x.text);
+    result.freqMHz = x.freqMHz;
+  }
+  await run('translate', async () => {});
+  await run('map', async () => {});
+  await run('par', async () => {
+    const args = ['--chipdb', status.chipdb, '--xdc', 'nextpnr.xdc', '--json', 'synth.json', '--write', 'routed.json', '--fasm', 'routed.fasm', '--log', 'nextpnr.log'];
+    if (result.freqMHz) args.push('--freq', String(result.freqMHz));
+    await tool('nextpnr-xilinx', args, { echo: true });
+  });
+  await run('trce', async () => {
+    const r = nextpnrReports(await fs.readFile(path.join(out, 'nextpnr.log'), 'utf8').catch(() => ''));
+    for (const c of r.timing.clocks) job.log(`Timing (nextpnr's estimate): clock ${c.clock}: ${c.maxFreqMHz} MHz (${c.pass ? 'PASS' : 'FAIL'} at ${c.targetMHz} MHz)`);
+  });
+  await run('bitgen', async () => {
+    await tool('fasm2frames', ['--db-root', status.db.root, '--part', status.db.part, 'routed.fasm', 'frames']);
+    await tool('xc7frames2bit', ['--part_file', path.join(status.db.root, status.db.part, 'part.yaml'), '--part_name', status.db.part, '--frm_file', 'frames', '--output_file', `${top}.bit`]);
+    await fs.copyFile(path.join(out, `${top}.bit`), path.join(gen.buildDir, `${top}.bit`));
+    job.log(`Bitstream: build/openxc7/${top}.bit (copied to build/${top}.bit)`);
+  });
+  await run('fpgaview', () => importNextpnrView(job, { buildDir: gen.buildDir, top, part, cfg }));
+  job.log('=== SILINX DONE ===');
+  result.reports = await collectOpenXc7Reports(gen.buildDir, top, project.device);
+  await fs.writeFile(path.join(gen.buildDir, 'reports.json'), JSON.stringify(result.reports, null, 2) + '\n');
+  return result;
+}
+
+/** View Implemented Design of the open flow: implview import-nextpnr of nextpnr's JSON and FASM (the part's device file
+ *  first, implview device, when the build's cache has none: it needs Vivado once). */
+async function importNextpnrView(job, { buildDir, top, part, cfg }) {
+  const out = path.join(buildDir, 'openxc7');
+  if (!fss.existsSync(path.join(out, 'routed.json'))) throw Object.assign(new Error('no nextpnr result (build/openxc7/routed.json): run Place & Route first'), { status: 400 });
+  if (!deviceFileOf(buildDir, part)) await runImplview(job, ['device', part], { buildDir, cfg });
+  await runImplview(job, ['import-nextpnr', path.join('openxc7', 'routed.json'), '--fasm', path.join('openxc7', 'routed.fasm'), '--part', part, '--top', top, '-o', path.join('openxc7', 'implview.ivd.gz')], { buildDir, cfg });
+}
+
+const readIf = async f => { try { return await fs.readFile(f, 'utf8'); } catch { return null; } };
+
+/** The reports of an open 7-series build (build/reports.json's shape, source 'openxc7'). */
+export async function collectOpenXc7Reports(buildDir, top, device) {
+  const out = path.join(buildDir, 'openxc7');
+  const r = { generatedAt: new Date().toISOString(), top, device: device || null, source: 'openxc7' };
+  const stat = await readIf(path.join(out, 'synth_stat.txt'));
+  if (stat) {
+    const cells = [...stat.matchAll(/^\s+(\d+)\s+([A-Z][A-Z0-9_]*)\s*$/gm)].map(m => ({ name: m[2], used: +m[1] }));   // (the cells by type: '   8   CARRY4')
+    r.synthesis = { utilization: cells, errors: 0, warnings: (await readIf(path.join(out, 'yosys.log')) || '').split('\n').filter(l => /^Warning:/.test(l)).length };
+  }
+  const log = await readIf(path.join(out, 'nextpnr.log'));
+  if (log) {
+    const n = nextpnrReports(log);
+    r.map = { utilization: n.utilization.map(u => ({ ...u, level: 0 })), summary: nextpnrSummary(n.utilization), errors: (log.match(/^ERROR:/gm) || []).length, warnings: (log.match(/^Warning:/gm) || []).length };
+    r.par = { routed: n.routed };
+    r.timing = n.timing;
+  }
+  if (fss.existsSync(path.join(out, `${top}.bit`))) r.bit = { path: path.join(out, `${top}.bit`), size: fss.statSync(path.join(out, `${top}.bit`)).size };
+  r.summary = { synthesized: !!r.synthesis, mapped: !!r.map, routed: r.par ? r.par.routed : null, timingMet: r.timing?.met ?? null, maxFreqMHz: r.timing?.maxFreqMHz ?? null, utilization: r.map?.summary || null, drc: null, bitstream: !!r.bit };
+  return r;
+}
