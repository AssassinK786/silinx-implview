+    const { startImplementation } = await import('./impl-routes.js');
+    await wait(await startImplementation(name, { steps: ['fpgaview'] }), timeoutS, 'View Implemented Design');
+    m = await implviewViewModel(buildDir, pj.top, { source });
+  }
+  if (!m.available) throw toolError(m.reason === 'no-ncd' ? `'${name}' has no routed design: run_process implement first` : m.error || `the implemented design of '${name}' is not exported (${m.reason}): fpga_view with make true`);
+  return m;
+}
+
+export const IMPLVIEW_TOOLS = [
+  {
+    name: 'fpga_view', title: 'View Implemented Design (FPGA) of a 7-series build',
+    description: 'The implemented design inside the FPGA, as View Implemented Design (FPGA) shows it, of a 7-series build: AMD Vivado\'s routed checkpoint (implview export --detail) or the open 7-series flow\'s (openXC7: implview import-nextpnr and nextpnr\'s JSON). Without site or net: the device, the utilisation and the modules (sites per hierarchy path). site: that site\'s cells (LUT equations on the BEL pins with their input nets, flip-flops and their settings) and pins with their nets. net: its driver, loads, kind (clock / signal) and the tiles its route goes through. make: export the routed design first when it is not (or is older than the build).',
+    inputSchema: { type: 'object', properties: { project: PROJECT, site: STR('A site, e.g. SLICE_X0Y47.'), net: STR('A net, by its name.'), make: { type: 'boolean', description: 'Export the routed design first when needed (default true).' }, timeout_s: { type: 'integer', description: 'How long to wait for the export, in seconds (default 600).' } }, required: ['project'], additionalProperties: false },
+    annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: true },
+    async run({ project: name, site, net, make = true, timeout_s: timeoutS = 600 }) {
+      const pj = await readProject(name);
+      if (!pj.top) throw toolError(`the project '${name}' has no top module`);
+      const { vivadoDevice } = await import('../packages/silinx-fpga/src/parts.js');
+      if (!vivadoDevice(pj.device)) throw toolError(`fpga_view is for the 7-series builds (AMD Vivado, the open 7-series flow): '${name}' is a ${String(pj.device?.part || '').toUpperCase()}`);
+      const m = await viewModel(name, pj, { make, timeoutS });
+      const head = { project: name, source: m.source, tool: m.tool, part: m.device.part, design: m.design.name };
+      if (site) {
+        const i = m.insts.find(x => x.site.toLowerCase() === String(site).toLowerCase());
+        if (!i) throw toolError(`site '${site}' is not used by the design (${m.insts.length} sites are)`);
+        const pins = Object.fromEntries(Object.entries(i.pins).map(([p, k]) => [p, m.nets[k].name]));
+        const data = { ...head, site: i.site, type: i.type, tile: i.tile, module: i.module, cells: i.cells.map(({ bel, kind, name: n, ref, eq, text, inputs, init }) => ({ bel, kind, name: n, ref, eq, text, inputs, init })), settings: i.opt, pins, io: i.io || null };
+        return { text: clip(JSON.stringify(data, null, 2)), data, untrusted: 'the design\'s names' };
+      }
+      if (net) {
+        const n = m.nets.find(x => x.name === net) || m.nets.find(x => x.name.toLowerCase() === String(net).toLowerCase());
+        if (!n) throw toolError(`no net '${net}'`);
+        const end = ([k, p]) => ({ site: m.insts[k].site, pin: p });
+        const data = { ...head, net: n.name, kind: n.kind, driver: n.driver ? end(n.driver) : null, loads: n.loads.map(end), tiles: n.tiles, pips: n.pips };
+        return { text: clip(JSON.stringify(data, null, 2)), data, untrusted: 'the design\'s names' };
+      }
+      const data = { ...head, util: m.util, modules: m.modules, sites: m.insts.length, nets: m.nets.length, clocks: m.nets.filter(x => x.kind === 'clock').map(x => ({ name: x.name, loads: x.loads.length })) };
+      return { text: clip(JSON.stringify(data, null, 2)), data, untrusted: 'the design\'s names' };
+    },
+  },
+  {
+    name: 'cross_check', title: 'Cross-Check a 7-series build against its bitstream',
+    description: 'Cross-Check, as the process of the interface: AMD Vivado\'s build checked against its bitstream decoded by Project X-Ray\'s bit2fasm (implview crosscheck: the used slices, LUT and FF BELs, each LUT\'s physical INIT, FF INIT / reset and the slices\' CE / SR / FFSYNC / LATCH / CLKINV, the pips) and Vivado\'s own checks (report_route_status, ROUTE vs get_nodes); the open 7-series flow\'s bitstream decoded against nextpnr\'s FASM (they must agree on every feature with configuration bits) and encoded again against its frames; both builds compared when there are both. UltraScale+ / Versal: not cross-checkable (no open bitstream database), Vivado\'s own checks only. The report is also build/crosscheck.txt and build/crosscheck.json.',
+    inputSchema: { type: 'object', properties: { project: PROJECT, timeout_s: { type: 'integer', description: 'How long to wait, in seconds (default 1200, at most 7200).' } }, required: ['project'], additionalProperties: false },
+    annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: true },
+    async run({ project: name, timeout_s: timeoutS = 1200 }) {
+      if (!Number.isInteger(timeoutS) || timeoutS < 1 || timeoutS > 7200) throw toolError('timeout_s: from 1 to 7200 s');
+      await readProject(name);
+      const { startCrossCheck } = await import('./impl-routes.js');
+      let job;
+      try { job = await startCrossCheck(name); } catch (e) { throw toolError(e.message); }
+      await wait(job, timeoutS, 'Cross-Check');
+      const r = job.result;
+      return { text: r.text, data: { project: name, part: r.part, family: r.family, checkable: r.checkable, vivado: r.vivado || null, openxc7: r.openxc7 || null, comparison: r.comparison || null } };
+    },
+  },
+];
