diff --git a/test/implview-model.test.js b/test/implview-model.test.js
new file mode 100644
index 0000000..f200797
--- /dev/null
+++ b/test/implview-model.test.js
@@ -0,0 +1,142 @@
+// View Implemented Design (FPGA) of a 7-series build (#implview, core/implview-model.js): implview's design and device
+// files (a part of blinky's AMD Vivado build on the Arty S7-25: two slices, the clock's pad and buffer) as the view's
+// model; each LUT's equation checked against its INIT through its pin map on all 64 addresses (xdl.js evalLut, an
+// independent evaluator); the open flow's nextpnr JSON; the malformed files refused.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { parseIvd, parseIvdev, implviewModel, nextpnrModel, lutEquation, nextpnrPath, isIoType } from '../core/implview-model.js';
+import { evalLut } from '../packages/silinx-fpga/src/xdl.js';
+
+const FIX = path.join(path.dirname(fileURLToPath(import.meta.url)), 'fixtures', 'implview');
+const ivd = parseIvd(fs.readFileSync(path.join(FIX, 'blinky-s7.ivd'), 'utf8'));
+const dev = parseIvdev(fs.readFileSync(path.join(FIX, 'xc7s25-part.ivdev'), 'utf8'));
+
+/** The value of a LUT cell at a physical address (A1 the least significant bit): its INIT at the logical address. */
+function initAt(init, pinmap, addr) {
+  const m = /^(\d+)'h([0-9A-F]+)$/i.exec(init);
+  const bits = BigInt(`0x${m[2]}`);
+  let a = 0;
+  for (const p of pinmap.split(' ')) { const [l, ph] = p.split(':'); if (addr >> (+ph[1] - 1) & 1) a |= 1 << +l.slice(1); }
+  return Number((bits >> BigInt(a)) & 1n);
+}
+
+test('the design and device files read: their records', () => {
+  assert.equal(ivd.info.part, 'xc7s25csga324-1');
+  assert.equal(ivd.info.top, 'top');
+  assert.equal(ivd.cells.length, 20);
+  assert.equal(ivd.nets.length, 24);
+  assert.deepEqual(ivd.cells[0], { site: 'BUFGCTRL_X0Y16', bel: 'BUFG', ref: 'BUFG', group: 'CLK', name: 'clk_IBUF_BUFG_inst' });
+  assert.equal(dev.info.part, 'xc7s25csga324-1');
+  assert.ok(dev.tiles.length > 10 && dev.sites.some(s => s.name === 'SLICE_X2Y45'));
+  assert.equal(dev.pins.get('IOB_X0Y74'), 'F14');
+});
+
+test('the model: the grid, the used sites by module, the utilisation', () => {
+  const m = implviewModel(ivd, dev);
+  assert.equal(m.source, 'vivado');
+  assert.equal(m.tool, 'AMD Vivado 2025.2.1');
+  assert.deepEqual(m.design, { name: 'top', part: 'xc7s25csga324-1' });
+  assert.equal(m.device.rows, 105);
+  assert.equal(m.device.cols, 102);
+  assert.deepEqual(m.insts.map(i => [i.site, i.type, i.module]), [
+    ['BUFGCTRL_X0Y16', 'BUFG', ''], ['IOB_X0Y74', 'IOB33', ''], ['SLICE_X3Y45', 'SLICEL', 'u_knight'], ['SLICE_X2Y45', 'SLICEM', 'u_knight']]);
+  assert.deepEqual(m.modules, { '': 2, u_knight: 2 });
+  assert.deepEqual(m.util['Slices'], { used: 2, total: 12 });   // (the fixture's part of the device: its tiles' slices)
+  assert.deepEqual(m.util['Global clock buffers'], { used: 1, total: 16 });
+  // the I/O: its port, package pin, standard
+  const io = m.insts[1];
+  assert.equal(io.name, 'clk');
+  assert.deepEqual(io.io, { pad: 'F14', dir: 'in', standard: 'LVCMOS33', drive: null, slew: null, pull: null });
+});
+
+test('each LUT\'s equation equals its INIT on every address; its inputs\' nets', () => {
+  const m = implviewModel(ivd, dev);
+  let checked = 0;
+  for (const [ci, c] of ivd.cells.entries()) {
+    if (c.group !== 'LUT') continue;
+    const d = ivd.details.get(ci);
+    const cell = m.insts.flatMap(i => i.cells).find(x => x.name === c.name);
+    assert.equal(cell.kind, 'lut');
+    assert.equal(cell.size, 6);
+    for (let a = 0; a < 64; a++) {
+      const v = Object.fromEntries(Array.from({ length: 6 }, (_, k) => [`A${k + 1}`, a >> k & 1]));
+      assert.equal(evalLut(cell.eq, v), initAt(d.INIT, d.PINMAP, a), `${c.name} ${cell.eq} at ${a}`);
+    }
+    checked++;
+  }
+  assert.equal(checked, 9);
+  const s = m.insts.find(i => i.site === 'SLICE_X3Y45');
+  const inv = s.cells.find(c => c.name === 'u_knight/count[0]_i_1');
+  assert.equal(inv.eq, '~A2');
+  assert.deepEqual(Object.keys(inv.inputs), ['A2']);
+  assert.equal(inv.text, `¬${inv.inputs.A2}`);
+});
+
+test('the flip-flops: their settings; the clock net from the buffer to the slices', () => {
+  const m = implviewModel(ivd, dev);
+  const s = m.insts.find(i => i.site === 'SLICE_X2Y45');
+  assert.equal(s.opt.AFF_INIT_ATTR, 'INIT0');
+  assert.equal(s.opt.AFF_SR_ATTR, 'SRLOW');
+  assert.equal(s.opt.SYNC_ATTR, 'SYNC');
+  const clk = m.nets.find(n => n.name === 'clk_IBUF_BUFG');
+  assert.equal(clk.kind, 'clock');
+  assert.equal(m.insts[clk.driver[0]].site, 'BUFGCTRL_X0Y16');
+  assert.deepEqual([...new Set(clk.loads.map(([k, p]) => `${m.insts[k].site}.${p}`))].sort(), ['SLICE_X2Y45.CLK', 'SLICE_X3Y45.CLK']);
+  assert.ok(clk.tiles.length > 1 && clk.pips > 0);
+  assert.equal(s.pins.CLK, m.nets.indexOf(clk));
+});
+
+test('lutEquation: constants, an inverter, a pin map, malformed INITs', () => {
+  assert.deepEqual(lutEquation("2'h1", 'I0:A3'), { eq: '~A3', inputs: ['A3'] });
+  assert.deepEqual(lutEquation("4'h2", 'I0:A5 I1:A2'), { eq: '~A2*A5', inputs: ['A2', 'A5'] });
+  assert.deepEqual(lutEquation("4'h8", 'I0:A1 I1:A6'), { eq: 'A1*A6', inputs: ['A1', 'A6'] });
+  assert.equal(lutEquation("4'h6", 'I0:A1 I1:A2').eq.split('+').length, 2);   // (an XOR: two terms)
+  assert.deepEqual(lutEquation("4'h0", 'I0:A1 I1:A2'), { eq: '0', inputs: ['A1', 'A2'] });
+  assert.deepEqual(lutEquation("4'hF", 'I0:A1 I1:A2'), { eq: '1', inputs: ['A1', 'A2'] });
+  assert.deepEqual(lutEquation("1'b1", ''), { eq: '1', inputs: [] });
+  assert.equal(lutEquation('', 'I0:A1'), null);
+  assert.equal(lutEquation('xyz', 'I0:A1'), null);
+});
+
+test('the open flow: nextpnr\'s cells and nets on implview\'s placement', () => {
+  const ivdN = parseIvd(['#implview-design\t1', 'part\txc7s25csga324-1', 'top\ttop', 'nextpnr\tnextpnr-xilinx',
+    'U\tSLICE_X2Y45\tA6LUT\tLUT\tLUT\tu_a.inv', 'U\tSLICE_X2Y45\tAFF\tFDRE\tFLOP_LATCH\t$auto$ff$1', 'U\tBUFGCTRL_X0Y16\tBUFG\tBUFGCTRL\tCLOCK\tclkbuf'].join('\n'));
+  const json = { modules: { top: { attributes: { top: '1' }, cells: {
+    'u_a.inv': { type: 'SLICE_LUTX', parameters: { INIT: '01'.padStart(64, '0').replace(/.$/, '1').replace(/^0+1$/, '01') }, attributes: { X_ORIG_TYPE: 'LUT1' }, port_directions: { A3: 'input', O6: 'output' }, connections: { A3: [10], O6: [11] } },
+    '$auto$ff$1': { type: 'SLICE_FFX', parameters: { INIT: '0' }, attributes: { X_ORIG_TYPE: 'FDRE' }, port_directions: { CK: 'input', D: 'input', Q: 'output' }, connections: { CK: [12], D: [11], Q: [10] } },
+    clkbuf: { type: 'BUFGCTRL', parameters: {}, attributes: {}, port_directions: { O: 'output' }, connections: { O: [12] } },
+  }, netnames: {
+    'u_a.q': { bits: [10], attributes: { ROUTING: 'SITEWIRE/SLICE_X2Y45/AQ;;1;INT_L_X2Y45/LOGIC_OUTS_L4;INT_L_X2Y45/INT_L.LOGIC_OUTS_L4->>IMUX_L3;1;' } },
+    '$abc$d': { bits: [11], attributes: {} },
+    clk: { bits: [12], attributes: { ROUTING: 'CLK_BUFG_BOT_R_X60Y48/CLK_BUFG_BUFGCTRL0_O;;1' } },
+  } } } };
+  // the inverter of A3: its 64-bit INIT (the last character address 0) 1 where A3 = 0
+  json.modules.top.cells['u_a.inv'].parameters.INIT = Array.from({ length: 64 }, (_, k) => ((63 - k) >> 2 & 1 ? '0' : '1')).join('');
+  const m = nextpnrModel(ivdN, dev, json);
+  assert.equal(m.source, 'openxc7');
+  assert.equal(m.tool, 'nextpnr-xilinx');
+  const s = m.insts.find(i => i.site === 'SLICE_X2Y45');
+  assert.equal(s.module, 'u_a');
+  const lut = s.cells.find(c => c.kind === 'lut');
+  assert.equal(lut.eq, '~A3');
+  assert.deepEqual(lut.inputs, { A3: 'u_a/q' });
+  const ff = s.cells.find(c => c.kind === 'ff');
+  assert.equal(ff.name, 'u_a/q');   // (Yosys's own name: its output's net's)
+  assert.equal(s.opt.AFF_INIT_ATTR, 'INIT0');
+  const clk = m.nets.find(n => n.name === 'clk');
+  assert.equal(clk.kind, 'clock');
+  assert.deepEqual(m.nets.find(n => n.name === 'u_a/q').tiles, ['INT_L_X2Y45']);
+  assert.equal(m.nets.find(n => n.name === 'u_a/q').pips, 1);
+});
+
+test('names and I/O site types; malformed files refused', () => {
+  assert.equal(nextpnrPath('u_uart.u_rx.state_q'), 'u_uart/u_rx/state_q');
+  assert.equal(nextpnrPath('$abc$1$lut'), '$abc$1$lut');
+  for (const t of ['IOB33', 'IOB33M', 'IOB18S', 'IOB', 'HPIOB']) assert.ok(isIoType(t), t);
+  for (const t of ['SLICEL', 'RAMB18E1', 'BUFGCTRL']) assert.ok(!isIoType(t), t);
+  assert.throws(() => parseIvd('#implview-device\t1\n'), /not an implview design file/);
+  assert.throws(() => parseIvdev('#implview-design\t1\n'), /not an implview device file/);
+});
