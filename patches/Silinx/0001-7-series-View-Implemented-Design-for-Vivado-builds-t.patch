diff --git a/test/openxc7.test.js b/test/openxc7.test.js
new file mode 100644
index 0000000..0dc3483
--- /dev/null
+++ b/test/openxc7.test.js
@@ -0,0 +1,126 @@
+// The open 7-series flow of the native tools (openXC7, #openxc7: core/openxc7.js, server/openxc7.js), what needs no
+// program: the XDC as nextpnr-xilinx reads it, nextpnr's log as reports, the parts' names in Project X-Ray's database,
+// which families an open database cross-checks, the steps, the chip database and the database of Toolchain Settings,
+// the Yosys script, the reports of a build folder (a recorded nextpnr log).
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { nextpnrXdc, nextpnrReports, nextpnrSummary, prjxrayFamily, prjxrayParts, crossCheckability } from '../core/openxc7.js';
+import { openXc7Steps, chipdbOf, prjxrayDbOf, yosysScript, collectOpenXc7Reports, openXc7Status } from '../server/openxc7.js';
+
+let tmp;
+before(() => { tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'silinx-openxc7-')); });
+after(() => fs.rmSync(tmp, { recursive: true, force: true }));
+
+const LOG = `Info: Device utilisation:
+Info: 	         SLICE_LUTX:    88/29200     0%
+Info: 	          SLICE_FFX:    33/29200     0%
+Info: 	             CARRY4:    10/ 3650     0%
+Info: 	                PAD:     6/  210     2%
+Info: 	           BUFGCTRL:     2/   32     6%
+Info: 	           RAMB18E1:     0/  180     0%
+Info:
+Info: Max frequency for clock 'u_clk/CLK': 310.27 MHz (PASS at 100.00 MHz)
+Info: Routing globals...
+Info: Max frequency for clock 'u_clk/CLK': 296.12 MHz (PASS at 100.00 MHz)
+Info: Max frequency for clock 'u_clk/clk_div': 402.58 MHz (PASS at 12.00 MHz)
+Info: Routing complete.
+Info: Program finished normally.
+`;
+
+test('nextpnrXdc: -dict and single properties per port, the clock\'s frequency, what it leaves out', () => {
+  const x = nextpnrXdc(`## Arty S7-25
+set_property -dict {PACKAGE_PIN R2  IOSTANDARD SSTL135} [get_ports CLK100MHZ]
+create_clock -name sys_clk -period 10.000 [get_ports CLK100MHZ]
+set_property -dict { PACKAGE_PIN E18 IOSTANDARD LVCMOS33 } [get_ports {led[0]}]
+set_property PULLTYPE PULLUP [get_ports btn0] ; # a comment
+set_false_path -from [get_ports btn0]
+set_property CFGBVS VCCO [current_design]`);
+  assert.equal(x.text, ['set_property PACKAGE_PIN R2 [get_ports {CLK100MHZ}]', 'set_property IOSTANDARD SSTL135 [get_ports {CLK100MHZ}]',
+    'set_property PACKAGE_PIN E18 [get_ports {led[0]}]', 'set_property IOSTANDARD LVCMOS33 [get_ports {led[0]}]', 'set_property PULLTYPE PULLUP [get_ports {btn0}]', ''].join('\n'));
+  assert.equal(x.freqMHz, 100);
+  assert.deepEqual(x.ports, ['CLK100MHZ', 'led[0]', 'btn0']);
+  assert.deepEqual(x.dropped, ['set_false_path -from [get_ports btn0]', 'set_property CFGBVS VCCO [current_design]']);
+  assert.deepEqual(nextpnrXdc(''), { text: '', freqMHz: null, ports: [], dropped: [] });
+});
+
+test('nextpnrReports: the utilisation, the last timing estimate of each clock, routed', () => {
+  const r = nextpnrReports(LOG);
+  assert.deepEqual(r.utilization.map(u => [u.name, u.used, u.total]), [['SLICE_LUTX', 88, 29200], ['SLICE_FFX', 33, 29200], ['CARRY4', 10, 3650], ['PAD', 6, 210], ['BUFGCTRL', 2, 32], ['RAMB18E1', 0, 180]]);
+  assert.deepEqual(r.timing.clocks, [{ clock: 'u_clk/CLK', maxFreqMHz: 296.12, targetMHz: 100, pass: true }, { clock: 'u_clk/clk_div', maxFreqMHz: 402.58, targetMHz: 12, pass: true }]);
+  assert.equal(r.timing.met, true);
+  assert.equal(r.timing.maxFreqMHz, 296.12);
+  assert.equal(r.routed, true);
+  const failed = nextpnrReports(LOG.replace('PASS at 12.00', 'FAIL at 500.00') + 'ERROR: something\n');
+  assert.equal(failed.timing.met, false);
+  assert.equal(failed.routed, false);
+  assert.equal(failed.timing.timingErrors, 1);
+  assert.deepEqual(nextpnrReports('').timing, { met: null, timingErrors: 0, maxFreqMHz: null, minPeriodNs: null, clocks: [], model: "nextpnr-xilinx's estimate" });
+  const s = nextpnrSummary(r.utilization);
+  assert.deepEqual(s.luts, { used: 88, total: 29200, percent: 0.3 });
+  assert.deepEqual(s.iobs, { used: 6, total: 210, percent: 2.86 });
+  assert.equal(s.dsp, null);
+});
