+++ b/test/mcp-implview.test.js
@@ -0,0 +1,91 @@
+// The MCP server's fpga_view and cross_check (#implview, #crosscheck, #2674: what View Implemented Design (FPGA) and
+// Cross-Check do in the interface), through the same functions: a 7-series build's view made from implview's recorded
+// files (a part of blinky's AMD Vivado build on the Arty S7-25: test/fixtures/implview), its site and net queries, the
+// cache; the refusals (another family, nothing built, an unknown site or net); the open flow's synthesis tool.
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import zlib from 'node:zlib';
+import { fileURLToPath } from 'node:url';
+import { scratchEnv } from './server-helpers.js';
+
+const FIX = path.join(path.dirname(fileURLToPath(import.meta.url)), 'fixtures', 'implview');
+let tmp;
+before(async () => { tmp = await scratchEnv('silinx-mcp-implview-'); });
+after(() => fs.rmSync(tmp, { recursive: true, force: true }));
+
+const { handle, TOOLS } = await import('../server/mcp.js');
+const P = await import('../server/projects.js');
+let id = 0;
+async function call(name, args = {}) {
+  const r = (await handle({ jsonrpc: '2.0', id: ++id, method: 'tools/call', params: { name, arguments: args } })).result;
+  return { text: r.content[0].text, data: r.structuredContent, isError: r.isError };
+}
+const ok = async (name, args) => { const r = await call(name, args); assert.equal(r.isError, false, r.text); return r; };
+const fails = async (name, args, message) => { const r = await call(name, args); assert.equal(r.isError, true, r.text); assert.equal(r.text.split('\n[Untrusted')[0], `${name}: ${message}`); };
+
+/** A Vivado build of a project: its routed checkpoint (a stand-in), then implview's export of it. */
+function vivadoBuild(name) {
+  const b = path.join(P.projectDir(name), 'build'), iv = path.join(b, 'implview');
+  fs.mkdirSync(path.join(iv, 'cache', 'devices'), { recursive: true });
+  fs.writeFileSync(path.join(b, 'post_route.dcp'), 'stand-in');
+  const old = new Date(Date.now() - 60000);
+  fs.utimesSync(path.join(b, 'post_route.dcp'), old, old);
+  fs.writeFileSync(path.join(iv, 'top.ivd.gz'), zlib.gzipSync(fs.readFileSync(path.join(FIX, 'blinky-s7.ivd'))));
+  fs.writeFileSync(path.join(iv, 'cache', 'devices', 'xc7s25csga324-1.ivdev.gz'), zlib.gzipSync(fs.readFileSync(path.join(FIX, 'xc7s25-part.ivdev'))));
+}
+
+test('fpga_view and cross_check: listed, their schemas', () => {
+  const v = TOOLS.find(t => t.name === 'fpga_view'), x = TOOLS.find(t => t.name === 'cross_check');
+  assert.deepEqual(Object.keys(v.inputSchema.properties), ['project', 'site', 'net', 'make', 'timeout_s']);
+  assert.deepEqual(Object.keys(x.inputSchema.properties), ['project', 'timeout_s']);
+  assert.deepEqual([v.inputSchema.required, x.inputSchema.required], [['project'], ['project']]);
+  assert.equal(v.annotations.destructiveHint, false);
+});
+
+test('fpga_view: a Vivado build\'s device, utilisation and modules; a site; a net; the cache', async () => {
+  await ok('new_project_from_example', { name: 'b7', example: 'blinky', board: 'arty-s7', variant: '25' });
+  await ok('set_design_properties', { project: 'b7', synth_tool: 'vivado' });
+  await fails('fpga_view', { project: 'b7', make: false }, '\'b7\' has no routed design: run_process implement first');
+  vivadoBuild('b7');
+  const all = await ok('fpga_view', { project: 'b7', make: false });
+  assert.deepEqual([all.data.source, all.data.tool, all.data.part, all.data.design], ['vivado', 'AMD Vivado 2025.2.1', 'xc7s25csga324-1', 'top']);
+  assert.deepEqual(all.data.modules, { '': 2, u_knight: 2 });
+  assert.deepEqual(all.data.clocks, [{ name: 'clk_IBUF_BUFG', loads: 9 }]);
+  assert.equal(all.data.untrusted.content, 'the design\'s names');
+  assert.ok(fs.existsSync(path.join(P.projectDir('b7'), 'build', 'implview', 'fpga-view-vivado.json')));
+  const site = await ok('fpga_view', { project: 'b7', site: 'slice_x3y45' });
+  assert.equal(site.data.site, 'SLICE_X3Y45');
+  assert.equal(site.data.module, 'u_knight');
+  assert.deepEqual(site.data.cells.find(c => c.name === 'u_knight/count[0]_i_1'), { bel: 'A6LUT', kind: 'lut', name: 'u_knight/count[0]_i_1', ref: 'LUT1', eq: '~A2', text: site.data.cells.find(c => c.name === 'u_knight/count[0]_i_1').text, inputs: { A2: site.data.pins.A2 }, init: "2'h1" });
+  assert.equal(site.data.pins.CLK, 'clk_IBUF_BUFG');
+  const net = await ok('fpga_view', { project: 'b7', net: 'clk_IBUF_BUFG' });
+  assert.deepEqual(net.data.driver, { site: 'BUFGCTRL_X0Y16', pin: 'BUFG.O' });
+  assert.equal(net.data.kind, 'clock');
+  await fails('fpga_view', { project: 'b7', site: 'SLICE_X0Y0' }, 'site \'SLICE_X0Y0\' is not used by the design (4 sites are)');
+  await fails('fpga_view', { project: 'b7', net: 'nope' }, 'no net \'nope\'');
+  // (a build newer than the export: stale, exported again only with make)
+  fs.writeFileSync(path.join(P.projectDir('b7'), 'build', 'post_route.dcp'), 'newer');
+  await fails('fpga_view', { project: 'b7', make: false }, 'the implemented design of \'b7\' is not exported (stale): fpga_view with make true');
+});
+
+test('the refusals: another family; cross_check with nothing built; the open flow\'s view not made', async () => {
+  await ok('new_project_from_example', { name: 's3', example: 'gates' });
+  await fails('fpga_view', { project: 's3' }, 'fpga_view is for the 7-series builds (AMD Vivado, the open 7-series flow): \'s3\' is a XC3S250E');
+  await fails('cross_check', { project: 's3' }, 'Cross-Check is for the 7-series builds (AMD Vivado, the open 7-series flow), not the XC3S250E');
+  await ok('new_project_from_example', { name: 'o7', example: 'blinky', board: 'arty-s7', variant: '25' });
+  const set = await ok('set_design_properties', { project: 'o7', synth_tool: 'openxc7' });
+  assert.match(set.text, /synthesis tool openxc7/);
+  // (an assistant's project: trusted by the user first, as Implement's tools)
+  await fails('cross_check', { project: 'o7' }, 'project \'o7\' was made through the MCP server (by an assistant): Cross-Check runs only once you trust it (Trust Project, in the console when the project opens)');
+  const pj = path.join(P.projectDir('o7'), 'silinx.json');
+  fs.writeFileSync(pj, JSON.stringify({ ...JSON.parse(fs.readFileSync(pj, 'utf8')), trusted: true }));
+  await fails('cross_check', { project: 'o7' }, 'nothing to cross-check: implement the design first (AMD Vivado, or the open 7-series flow up to Generate Programming File)');
+  await fails('fpga_view', { project: 'o7', make: false }, '\'o7\' has no routed design: run_process implement first');
+  await fails('cross_check', { project: 'o7', timeout_s: 0 }, 'timeout_s: from 1 to 7200 s');
+});
+
+test('set_design_properties: openxc7 only on a 7-series device', async () => {
+  await fails('set_design_properties', { project: 's3', synth_tool: 'openxc7' }, 'the open 7-series flow (openXC7) implements the 7-series devices, not the XC3S250E');
+});
