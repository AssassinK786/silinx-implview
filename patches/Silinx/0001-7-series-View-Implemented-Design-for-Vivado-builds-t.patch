+}
+
+const pct = v => (v == null ? '—' : `${v} %`);
+/** The report's text: one line per check. */
+export function crossCheckText(r) {
+  const L = [`Cross-Check (${r.part}, ${r.family})`];
+  if (!r.checkable) L.push(`  ${r.reason}`);
+  const v = r.vivado;
+  if (v) {
+    L.push('AMD Vivado: the routed design against its bitstream (implview crosscheck, Project X-Ray bit2fasm)');
+    if (v.sites) {
+      L.push(`  Used slices: ${v.sites.slices_fasm} of ${v.sites.slices_vivado} (${pct(v.sites.slices_match_pct)})`);
+      L.push(`  LUT BELs found: ${v.sites.lut_bels_vivado} (${pct(v.sites.lut_bels_found_pct)}); FF BELs: ${v.sites.ff_bels_vivado} (${pct(v.sites.ff_bels_match_pct)})`);
+    }
+    if (v.lut_init) L.push(`  LUT physical INIT: ${v.lut_init.match} of ${v.lut_init.compared} (${pct(v.lut_init.match_pct)})`);
+    if (v.ff) L.push(`  FF INIT / reset: ${v.ff.ffs} (${pct(v.ff.init_reset_match_pct)})${Object.entries(v.ff.slice_controls || {}).map(([k, c]) => `; ${k} ${pct(c.match_pct ?? c.pct)}`).join('')}`);
+    if (v.pips) L.push(`  PIPs: ${v.pips.match} of ${v.pips.vivado_pips_with_bits} Vivado pips found in the bitstream (${pct(v.pips.vivado_found_in_fasm_pct)}); bitstream pips explained by Vivado ${pct(v.pips.fasm_explained_by_vivado_pct)} (${pct(v.pips.fasm_explained_excl_defaults_pct)} without unused-mux defaults)`);
+    if (v.vivado) L.push(`  Vivado: report_route_status errors ${v.vivado.route_status_errors}; ROUTE vs get_nodes: ${v.vivado.route_vs_nodes_nets} nets, ${pct(v.vivado.route_vs_nodes_agree_pct)}`);
+  }
+  const o = r.openxc7;
+  if (o) {
+    L.push(`Open 7-series flow (openXC7): the bitstream decoded (bit2fasm, ${o.db}) against nextpnr's FASM`);
+    L.push(`  Set bits: nextpnr ${o.fasm.nextpnr}, bitstream ${o.fasm.decoded}, common ${o.fasm.common}: ${o.fasm.identical ? 'identical' : o.fasm.consistent ? 'identical on every feature with configuration bits' : 'MISMATCH'}`);
+    L.push(`  Only in nextpnr's FASM: ${o.fasm.onlyNextpnr.total} (${o.fasm.onlyNextpnr.noBits} of no configuration bit: pseudo pips; ${o.fasm.onlyNextpnr.unexplained} unexplained)`);
+    L.push(`  Only in the bitstream: ${o.fasm.onlyDecoded.total} (${o.fasm.onlyDecoded.noBits} zero-bit defaults, ${o.fasm.onlyDecoded.unusedSites} defaults of unused sites; ${o.fasm.onlyDecoded.unexplained} unexplained)`);
+    for (const s of [...o.fasm.onlyNextpnr.samples, ...o.fasm.onlyDecoded.samples]) L.push(`    ${s}`);
+    L.push(`  Frames: the decoded FASM encoded again ${o.frames.identical ? 'gives the same' : 'DIFFERS from the'} ${o.frames.built} frames`);
+  }
+  if (r.comparison) {
+    L.push('AMD Vivado against the open flow (the same sources, independent synthesis and place and route):');
+    for (const c of r.comparison) L.push(`  ${c.name}: Vivado ${c.vivado}, open flow ${c.open}`);
+  }
+  return L.join('\n');
+}
