diff --git a/server/skyline.js b/server/skyline.js
new file mode 100644
index 0000000..b56ec24
--- /dev/null
+++ b/server/skyline.js
@@ -0,0 +1,98 @@
+// 3D Skyline (#skyline; the process and the MCP server's fpga_skyline): a 7-series build's FASM drawn as a skyline on
+// its die, each tile a column as tall as the FASM features it sets, by the FASM skyline widget (t27.ai, Apache-2.0, run
+// as a program of its own: never part of Silinx) of the umbrella checkout (silinx-implview's skyline/).
+//   - the FASM: the open 7-series flow's nextpnr FASM (build/openxc7/routed.fasm); AMD Vivado's bitstream decoded by
+//     Project X-Ray's bit2fasm (Cross-Check's build/implview/crosscheck/design.fasm, else bit2fasm of build/<top>.bit),
+//     never one older than the build;
+//   - the die: skyline/build-grid.py of Project X-Ray's tilegrid.json (build/skyline/grid.json);
+//   - the page: skyline/make-page.mjs, build/skyline.html (self-contained, offline) and build/skyline/app.html (the
+//     interface's: its scripts from /vendor/skyline/, since the pages' Content-Security-Policy runs no inline script),
+//     and the counts the page shows, build/skyline/skyline.json.
+// The widget's folder: Toolchain Settings' paths.skyline (config.json only), else the umbrella checkout's
+// (<silinx>/../skyline).
+import fs from 'node:fs/promises';
+import fss from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { loadConfig, resolveTool } from './toolchain.js';
+import { runCommand, capture } from './jobs.js';
+import { vivadoPart } from './vivado.js';
+import { openXc7Status, prjxrayDbOf } from './openxc7.js';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const SKYLINE_HELP = 'The 3D Skyline is the FASM skyline widget of the silinx-implview checkout (its skyline/ folder, beside Silinx), or set "paths": {"skyline": "/path/to/skyline"} in ~/.silinx/config.json.';
+const mtime = p => { try { return fss.statSync(p).mtimeMs; } catch { return 0; } };
+
+/** The widget's folder: { found, dir, reason }. */
+export function skylineDir(cfg, { root = ROOT } = {}) {
+  const ok = d => fss.existsSync(path.join(d, 'make-page.mjs')) && fss.existsSync(path.join(d, 'build-grid.py'));
+  if (cfg?.paths?.skyline) {
+    const d = path.resolve(cfg.paths.skyline);
+    return ok(d) ? { found: true, dir: d, reason: `paths.skyline (${d})` } : { found: false, dir: null, reason: `paths.skyline (${cfg.paths.skyline}) has no make-page.mjs and build-grid.py` };
+  }
+  const sibling = path.resolve(root, '..', 'skyline');
+  return ok(sibling) ? { found: true, dir: sibling, reason: `the umbrella checkout's (${sibling})` } : { found: false, dir: null, reason: 'the skyline widget not found (paths.skyline, <silinx>/../skyline)' };
+}
+
+/** The FASM of a build: { file, label, flow } for the open flow's (synthTool openxc7), else for AMD Vivado's, or
+ *  { file: null, reason } when there is none or it is older than the build; `bit2fasm` when Vivado's bitstream must
+ *  be decoded first (no Cross-Check's FASM as new as the routed checkpoint). */
+export function skylineFasm(buildDir, top, synthTool) {
+  if (synthTool === 'openxc7') {
+    const f = path.join(buildDir, 'openxc7', 'routed.fasm');
+    if (!mtime(f)) return { file: null, reason: 'the open 7-series flow has no FASM (build/openxc7/routed.fasm): run Place & Route first' };
+    return { file: f, label: `${top}, openXC7 (nextpnr)`, flow: 'nextpnr-xilinx FASM (open 7-series flow, openXC7)' };
+  }
+  const dcp = mtime(path.join(buildDir, 'post_route.dcp'));
+  if (!dcp) return { file: null, reason: 'AMD Vivado has no routed design (build/post_route.dcp): run Place & Route first' };
+  const label = `${top}, Vivado (bit2fasm)`, flow = 'AMD Vivado\'s bitstream decoded by Project X-Ray bit2fasm';
+  const cc = path.join(buildDir, 'implview', 'crosscheck', 'design.fasm');
+  if (mtime(cc) >= dcp) return { file: cc, label, flow };
+  const bit = path.join(buildDir, `${top}.bit`), openBit = path.join(buildDir, 'openxc7', `${top}.bit`);
+  const sameAsOpen = () => { try { return fss.readFileSync(bit).equals(fss.readFileSync(openBit)); } catch { return false; } };
+  if (mtime(bit) < dcp || sameAsOpen()) return { file: null, reason: 'AMD Vivado\'s bitstream is missing or older than its routed design: run Generate Programming File (or Cross-Check) first' };
+  return { file: path.join(buildDir, 'skyline', 'vivado.fasm'), label, flow, bit2fasm: bit };
+}
+
+/** The 3D Skyline of a project's build: the page and its counts ({ part, die, grid, samples }, build/skyline/skyline.json). */
+export async function skylineProject(job, { project, projectDir }) {
+  const buildDir = path.join(projectDir, 'build'), top = project.top, part = vivadoPart(project.device);
+  const cfg = await loadConfig();
+  const w = skylineDir(cfg);
+  if (!w.found) throw Object.assign(new Error(`${w.reason}. ${SKYLINE_HELP}`), { status: 400 });
+  const f = skylineFasm(buildDir, top, project.synthTool);
+  if (!f.file) throw Object.assign(new Error(f.reason), { status: 400 });
+  const out = path.join(buildDir, 'skyline');
+  await fs.mkdir(out, { recursive: true });
+  const db = prjxrayDbOf(cfg, part);
+  if (f.bit2fasm) {
+    const st = openXc7Status(cfg, part);
+    if (!st.tools.bit2fasm) throw Object.assign(new Error(`bit2fasm not found (paths.bit2fasm or PATH). ${st.help}`), { status: 400 });
+    if (!db) throw Object.assign(new Error(`no Project X-Ray database of ${part} (openxc7.prjxrayDb)`), { status: 400 });
+    // bit2fasm writes the FASM on its standard output: kept in build/skyline/vivado.fasm, not in the log
+    job.log(`$ bit2fasm --db-root ${db.root} --part ${db.part} ${top}.bit > skyline/vivado.fasm`);
+    const dec = await capture(st.tools.bit2fasm, ['--db-root', db.root, '--part', db.part, `${top}.bit`], { cwd: buildDir, timeoutMs: 600000 });
+    if (dec.code !== 0) throw new Error(`bit2fasm failed (exit code ${dec.code})`);
+    await fs.writeFile(f.file, String(dec.out).split(/\r?\n/).filter(l => /^[A-Z0-9_]+_X\d+Y\d+\.\S/.test(l)).join('\n') + '\n');
+  }
+  const python = resolveTool('python3', cfg) || 'python3';
+  const run = async (cmd, args) => { const code = await runCommand(job, cmd, args, { cwd: buildDir }); if (code !== 0) throw new Error(`${path.basename(args[0])} failed (exit code ${code})`); };
+  const grid = path.join(out, 'grid.json');
+  // (the die's grid once per part: again when the script is newer)
+  const gridPart = path.join(out, 'grid.part');
+  const gridOf = fss.existsSync(gridPart) ? fss.readFileSync(gridPart, 'utf8') : '';
+  if (gridOf !== part || mtime(grid) < mtime(path.join(w.dir, 'build-grid.py'))) {
+    await run(python, ['-I', path.join(w.dir, 'build-grid.py'), db?.part || part, ...(db ? ['--db', path.dirname(db.root)] : []), '-o', grid]);
+    await fs.writeFile(gridPart, part);
+  }
+  await run(process.execPath, [path.join(w.dir, 'make-page.mjs'), '--grid', grid, '--part', part, '--fasm', f.file, '--label', f.label, '--flow', f.flow,
+    '-o', 'skyline.html', '--app-out', path.join('skyline', 'app.html'), '--json', path.join('skyline', 'skyline.json')]);
+  const r = JSON.parse(await fs.readFile(path.join(out, 'skyline.json'), 'utf8'));
+  job.log(`3D Skyline: build/skyline.html (${path.relative(buildDir, f.file)})`);
+  return r;
+}
+
+/** The interface's page of the last 3D Skyline (build/skyline/app.html), or null. */
+export async function skylineAppPage(buildDir) {
+  return fs.readFile(path.join(buildDir, 'skyline', 'app.html'), 'utf8').catch(() => null);
+}
