+  const data = { project: name, part: r.part, die: r.die, grid: { w: r.grid.w, h: r.grid.h, configTiles: r.grid.configTiles }, page: 'build/skyline.html',
+    fasm: s.fasm, flow: s.flow, features: s.features, tiles: s.tiles, share_pct: s.share, tallest: s.tallest, cleared: s.cleared, off_grid: s.off.length, families: s.families,
