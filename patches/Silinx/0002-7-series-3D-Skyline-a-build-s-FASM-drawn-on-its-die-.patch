diff --git a/test/skyline.test.js b/test/skyline.test.js
new file mode 100644
index 0000000..ec93afa
--- /dev/null
+++ b/test/skyline.test.js
@@ -0,0 +1,60 @@
+// 3D Skyline (#skyline, server/skyline.js; the MCP server's fpga_skyline): the widget's folder, the FASM of a build (the
+// open flow's nextpnr FASM, AMD Vivado's decoded bitstream, never one older than the build) and the tool's answer.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { skylineDir, skylineFasm } from '../server/skyline.js';
+import { skylineResult } from '../server/mcp-implview.js';
+
+const tmp = () => fs.mkdtempSync(path.join(os.tmpdir(), 'silinx-skyline-'));
+const put = (f, text = 'x', t = Date.now() / 1000) => { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, text); fs.utimesSync(f, t, t); };
+
+test('the widget\'s folder: paths.skyline, else the umbrella checkout\'s <silinx>/../skyline; one without its scripts refused', () => {
+  const d = tmp(), root = path.join(d, 'Silinx'), sky = path.join(d, 'skyline');
+  fs.mkdirSync(root);
+  assert.deepEqual(skylineDir({}, { root }), { found: false, dir: null, reason: 'the skyline widget not found (paths.skyline, <silinx>/../skyline)' });
+  put(path.join(sky, 'make-page.mjs')); put(path.join(sky, 'build-grid.py'));
+  assert.equal(skylineDir({}, { root }).dir, sky);
+  assert.match(skylineDir({}, { root }).reason, /^the umbrella checkout's/);
+  const other = path.join(d, 'other');
+  fs.mkdirSync(other);
+  assert.deepEqual(skylineDir({ paths: { skyline: other } }, { root }), { found: false, dir: null, reason: `paths.skyline (${other}) has no make-page.mjs and build-grid.py` });
+  assert.equal(skylineDir({ paths: { skyline: sky } }, { root: other }).dir, sky);
+});
+
+test('the FASM of a build: the open flow\'s routed.fasm; Vivado\'s Cross-Check FASM when as new as the routed design, else its bitstream decoded; none older than the build', () => {
+  const b = tmp(), now = Date.now() / 1000;
+  assert.match(skylineFasm(b, 'top', 'openxc7').reason, /no FASM \(build\/openxc7\/routed\.fasm\)/);
+  put(path.join(b, 'openxc7', 'routed.fasm'));
+  assert.deepEqual(skylineFasm(b, 'top', 'openxc7'), { file: path.join(b, 'openxc7', 'routed.fasm'), label: 'top, openXC7 (nextpnr)', flow: 'nextpnr-xilinx FASM (open 7-series flow, openXC7)' });
+  assert.match(skylineFasm(b, 'top', 'vivado').reason, /no routed design/);
+  put(path.join(b, 'post_route.dcp'), 'dcp', now - 100);
+  assert.match(skylineFasm(b, 'top', 'vivado').reason, /bitstream is missing or older/);
+  put(path.join(b, 'top.bit'), 'vivado bit', now - 50);
+  const dec = skylineFasm(b, 'top', 'vivado');
+  assert.deepEqual([dec.file, dec.bit2fasm, dec.label], [path.join(b, 'skyline', 'vivado.fasm'), path.join(b, 'top.bit'), 'top, Vivado (bit2fasm)']);
+  // (the open flow's bitstream copied to build/top.bit: not Vivado's)
+  put(path.join(b, 'openxc7', 'top.bit'), 'vivado bit');
+  assert.match(skylineFasm(b, 'top', 'vivado').reason, /bitstream is missing or older/);
+  // (Cross-Check's FASM: older than the routed design not taken, as new taken)
+  put(path.join(b, 'implview', 'crosscheck', 'design.fasm'), 'f', now - 200);
+  assert.match(skylineFasm(b, 'top', 'vivado').reason, /older/);
+  put(path.join(b, 'implview', 'crosscheck', 'design.fasm'), 'f', now - 10);
+  assert.equal(skylineFasm(b, 'top', 'vivado').file, path.join(b, 'implview', 'crosscheck', 'design.fasm'));
+  assert.equal(skylineFasm(b, 'top', 'vivado').bit2fasm, undefined);
+});
+
+test('fpga_skyline\'s answer: the page\'s counts, the tallest columns first (ties by name), as many as asked', () => {
+  const col = (tile, features, family = 'INT') => ({ tile, type: tile.replace(/_X\d+Y\d+$/, ''), family, features, gx: 1, gy: 2 });
+  const r = { part: 'xc7s25csga324-1', die: 'XC7S25', grid: { w: 102, h: 105, configTiles: 4996, source: {} }, samples: [{
+    file: 'top, openXC7 (nextpnr)', fasm: 'routed.fasm', flow: 'nextpnr', features: 30, tiles: 3, share: 0.06, cleared: 0, bad: 0,
+    tallest: { tile: 'INT_L_X2Y3', features: 12 }, families: { CLB: { tiles: 1, features: 8, onDie: 1000 } }, off: [],
+    columns: [col('CLBLL_L_X2Y3', 8, 'CLB'), col('INT_R_X3Y3', 10), col('INT_L_X2Y3', 12), col('INT_L_X2Y4', 10)] }] };
+  const { data } = skylineResult('p', r, 3);
+  assert.deepEqual(data.columns.map(c => [c.tile, c.features]), [['INT_L_X2Y3', 12], ['INT_L_X2Y4', 10], ['INT_R_X3Y3', 10]]);
+  assert.deepEqual([data.features, data.tiles, data.share_pct, data.tallest.tile, data.page, data.die], [30, 3, 0.06, 'INT_L_X2Y3', 'build/skyline.html', 'XC7S25']);
+  assert.deepEqual(Object.keys(data.columns[0]), ['tile', 'type', 'family', 'features']);
+  assert.equal(skylineResult('p', r, 0).data.columns.length, 0);
+});
