+/** Start a 3D Skyline of a project's 7-series build (POST /projects/:p/skyline; the MCP server's fpga_skyline). */
+export async function startSkyline(name) {
+  const P = Projects;
+  const bad = (msg, status = 400) => new P.HttpError(status, msg);
+  const project = await P.readProject(name);
+  if (!topOf(project)) throw bad('set the top module of the project before drawing its 3D Skyline');
+  if (!isVivadoDevice(project.device)) throw bad(`the 3D Skyline is for the 7-series builds (AMD Vivado, the open 7-series flow), not the ${String(project.device?.part || '').toUpperCase()}`);
+  if (!isTrusted(project)) throw bad(untrustedMessage(name, '3D Skyline', project), 403);
+  const key = name.toLowerCase();
+  const running = implJobs.get(key);
+  if (running && getJob(running)?.status === 'running') throw bad(`an implementation of '${name}' is running (job ${running}); wait for it`, 409);
+  const { skylineProject, skylineFasm } = await import('./skyline.js');
+  const f = skylineFasm(path.join(P.projectDir(name), 'build'), project.top, project.synthTool);
+  if (!f.file) throw bad(f.reason);
+  const job = createJob('skyline', j => skylineProject(j, { project, projectDir: P.projectDir(name) }), { meta: { project: name } });
+  implJobs.set(key, job.id);
+  return job;
+}
