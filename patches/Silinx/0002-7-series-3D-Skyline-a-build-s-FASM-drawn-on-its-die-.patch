diff --git a/web/js/skyline.js b/web/js/skyline.js
new file mode 100644
index 0000000..7ce4259
--- /dev/null
+++ b/web/js/skyline.js
@@ -0,0 +1,34 @@
+// Silinx - 3D Skyline (#skyline): a 7-series build's FASM drawn as a skyline on its die by the FASM skyline widget
+// (server/skyline.js), its lines in the console, its page in a tab of its own (made before the job ends, a tab the
+// browser opens only on the click); the page is also build/skyline.html, offline.
+import { api, followJob } from './api.js';
+import { S } from './app.js';
+import { log } from './console.js';
+import { SKYLINE } from './tool-descriptors.js';
+import { renderProcesses } from './processes.js';
+
+export async function runSkyline() {
+  if (!S.project) return;
+  const tab = window.open('', '_blank');
+  log(`\nStarted : "${SKYLINE}".\n`, 'hdr');
+  S.status.skyline = 'running';
+  renderProcesses();
+  let res;
+  try {
+    const { job } = await api.skyline(S.project.name);
+    res = await followJob(job, line => log(line, /^ERROR/.test(line) ? 'err' : /^(CRITICAL )?WARNING/.test(line) ? 'warn' : undefined));
+  } catch (e) { res = { status: 'error', error: e.message }; }
+  let ok = res.status === 'ok';
+  if (ok) {
+    // (the page's scripts the server's, /vendor/skyline/: the pages' Content-Security-Policy runs no inline script)
+    const page = await api.skylinePage(S.project.name).catch(e => ({ available: false, reason: e.message }));
+    if (page.available && tab) tab.location = URL.createObjectURL(new Blob([page.html.replaceAll('{{ORIGIN}}', location.origin)], { type: 'text/html' }));
+    else { ok = false; res.error = page.reason || 'the page could not be opened'; }
+  }
+  if (!ok) tab?.close();
+  S.status.skyline = ok ? 'ok' : 'err';
+  renderProcesses();
+  if (ok) log(`\nProcess "${SKYLINE}" completed successfully: the page is build/skyline.html`, 'ok');
+  else log(`ERROR: ${SKYLINE}: ${res.error || 'failed'}`, 'err');
+  return ok;
+}
